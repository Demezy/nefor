(require "agents")
(require "nefor.actors")
(require "nefor.artifact")
(require "nefor.contracts")
(require "nefor.dynamic")
(require "nefor.graph")

(type Task {:task String :description String :dependent_tasks (List String)})
(type WorkerResult {:task String :description String})
(type Summary {:content String})
(type IndexedTask {:index Int :value Task})

(let indexed-task (fn [[index Int] [task Task]] -> IndexedTask
  (as IndexedTask {:index index :value task})))
(let worker-id (fn [[entry IndexedTask]] -> String (str "expand.worker." (get entry "index"))))
(let worker (fn [[entry IndexedTask]] -> (nefor.graph.Node Task (| WorkerResult nefor.contracts.AgentError))
  (let task (get entry "value"))
  (let id (worker-id entry))
  (let agent (agents.with-tools agents.mock id
                (str "Complete this task: " (get task "description")) []
                (type-tag Task) (type-tag WorkerResult) 2))
  agent))

(let add-worker (fn [[change nefor.graph.Delta] [entry IndexedTask]] -> nefor.graph.Delta
  (let fragment (worker entry))
  (let with-fragment (nefor.graph.merge-delta change (nefor.graph.node-delta fragment)))
  (nefor.graph.delta-message-front with-fragment
    (get fragment "input") (get entry "value"))))


(let planner-agent (agents.with-tools agents.mock "planner"
  "Return the task plan." []
  (type-tag nefor.contracts.Task) (type-tag (List Task)) 2))
(let planner-success
  (nefor.actors.result-arm planner-agent (type-tag (List Task))))
(let planner-error-port
  (nefor.actors.result-arm planner-agent
    (type-tag nefor.contracts.AgentError)))
(let prompt (nefor.dynamic.collected-prompt "summary-input" (type-tag (| WorkerResult nefor.contracts.AgentError))))
(let summarizer (agents.with-tools agents.mock "summarizer"
  "Summarize the ordered worker results." []
  (type-tag nefor.contracts.ProviderInput) (type-tag Summary) 2))
(let result (nefor.graph.output "result"
  (type-tag (| Summary nefor.contracts.AgentError))))
(let summary-input (get prompt "input"))
(let expand (fn [[tasks (List Task)]] -> Artifact
  (let indexed (indexed-map indexed-task tasks))
  (let fragments (map worker indexed))
  (let outputs
    (map (fn [[fragment (nefor.graph.Node Task
                         (| WorkerResult nefor.contracts.AgentError))]]
           -> (nefor.graph.Port (| WorkerResult nefor.contracts.AgentError))
           (get fragment "output"))
         fragments))
  (let collection
    (nefor.dynamic.collect-all "expand.collector" outputs
      (type-tag (| WorkerResult nefor.contracts.AgentError))))
  (let workers
    (fold add-worker (get collection "change") indexed))
  (nefor.artifact.delta
    (nefor.graph.delta-route workers (get collection "output") summary-input))))

(let planner-error (fn [[error nefor.contracts.AgentError]] -> Artifact
    (nefor.artifact.delta
      (nefor.graph.delta-message (nefor.graph.delta
      (as (List nefor.graph.Actor) []) (as (List nefor.graph.StoredRoute) [])
      (as (List nefor.graph.Message) []) (as (List String) []))
      (get result "input")
      (as (| Summary nefor.contracts.AgentError) error)))))

(let initial
  (nefor.graph.delta-route
    (nefor.graph.delta-route
      (nefor.graph.merge-delta (nefor.graph.node-delta planner-agent)
        (nefor.graph.merge-delta (nefor.graph.node-delta prompt)
          (nefor.graph.merge-delta (nefor.graph.node-delta summarizer)
            (nefor.graph.node-delta result))))
      (get summarizer "output") (get result "input"))
    (get prompt "output") (get summarizer "input")))

(artifact (nefor.graph.lower-resident
    (nefor.graph.delta-message initial (get planner-agent "input")
      (as nefor.contracts.Task {:prompt "Plan this request"}))
    [(nefor.graph.rule "expand" planner-success "expand")
     (nefor.graph.rule "planner-error" planner-error-port "planner-error")]
    (get result "output")))
