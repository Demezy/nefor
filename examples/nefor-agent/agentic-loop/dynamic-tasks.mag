(require "agents")
(require "nefor.actors")
(require "nefor.artifact")
(require "nefor.contracts")
(require "nefor.dynamic")
(require "nefor.graph")
(require "nefor.node")

(type Task {:task String :description String :dependent_tasks (List String)})
(type WorkerResult {:task String :description String})
(type Summary {:content String})

;; One runtime occurrence becomes one ordinary worker node. The task is known
;; when this resident function runs, so it can shape both identity and prompt.
(let expand-task
  (fn [[entry (nefor.dynamic.Indexed Task)]] -> Artifact
    (let task (get entry "value"))
    (let worker
      (agents.with-tools agents.mock
        (str "expand.worker." (get entry "index"))
        (str "Complete this task: " (get task "description"))
        [] (type-tag Unit) (type-tag WorkerResult) 2))
    (nefor.dynamic.expand "expand" entry worker)))

(let start
  (nefor.actors.task-source "task" "Plan this request"))
(let planner
  (agents.dynamic-with-tools agents.mock "planner"
    "Return the ordered task plan." []
    (type-tag nefor.contracts.Task) (type-tag Task) 2))
(let workers
  (nefor.dynamic.traverse "expand" expand-task
    (type-tag Task)
    (type-tag (| WorkerResult nefor.contracts.AgentError))))
(let planner-error
  (nefor.graph.identity "planner-error"
    (type-tag nefor.contracts.AgentError)))
(let run-plan
  (nefor.node.choose "run-plan" workers planner-error))

;; Dynamic cardinality ends at an effect-aware context node. It waits for the
;; explicit completion event and sends one ordered provider turn downstream;
;; no runtime-sized MAG List value is invented.
(let summary-context
  (nefor.dynamic.context "summary-input"
    (type-tag (| WorkerResult nefor.contracts.AgentError))))
(let summarizer
  (agents.with-tools agents.mock "summarizer"
    "Summarize the ordered worker results." []
    (type-tag nefor.contracts.ProviderInput) (type-tag Summary) 2))
(let summarize
  (nefor.node.>>> summary-context summarizer))
(let run-error
  (nefor.graph.identity "run-error"
    (type-tag nefor.contracts.AgentError)))
(let finish
  (nefor.node.choose "finish" summarize run-error))

(let planned (nefor.node.>>> start planner))
(let ran (nefor.node.>>> planned run-plan))
(let workflow (nefor.node.>>> ran finish))
(let result (nefor.graph.output-for "result" workflow))

(artifact
  (nefor.artifact.compile
    (fn [[graph nefor.graph.Graph]] -> nefor.graph.Graph
      (nefor.graph.add-edges graph [(nefor.graph.edge workflow result)]))))
