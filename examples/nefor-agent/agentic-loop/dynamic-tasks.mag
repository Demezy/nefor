import core.types.{}
import agents.{}
import nefor.actors.{}
import nefor.agents.{}
import nefor.artifact.{}
import nefor.contracts.{}
import nefor.dynamic.{}
import nefor.graph.{}
import nefor.node.{}

type Task {task: String, description: String, dependent_tasks: List<String>}
type WorkerResult {task: String, description: String}
type Summary {content: String}

let occurrence = nefor.dynamic.trigger_ref(type_tag<nefor.dynamic.Indexed<Task>>())
let occurrence_collection = nefor.dynamic.field_ref(occurrence, "collection", type_tag<String>())
let occurrence_index = nefor.dynamic.field_ref(occurrence, "index", type_tag<Int>())
let occurrence_value = nefor.dynamic.field_ref(occurrence, "value", type_tag<Task>())
let occurrence_text = nefor.dynamic.field_ref(occurrence_value, "description", type_tag<String>())
let occurrence_index_text = nefor.dynamic.int_to_decimal_string_ref(occurrence_index)
let worker_id = nefor.dynamic.concat_strings_ref([nefor.dynamic.capture_ref("expand.worker.", type_tag<String>()), occurrence_index_text])
let worker_root = nefor.dynamic.concat_strings_ref([nefor.dynamic.capture_ref("expand-", type_tag<String>()), occurrence_index_text])
let worker_system = nefor.dynamic.concat_strings_ref([nefor.dynamic.capture_ref("Complete this task: ", type_tag<String>()), occurrence_text])
let worker_template = nefor.agents.dynamic_template_with_tools(agents.resolve_model, agents.mock, "expand", occurrence_collection, occurrence_index, worker_id, worker_root, worker_system, [], type_tag<WorkerResult>(), 2)

let start = nefor.actors.task_source("task", "Plan this request")
let planner = nefor.agents.dynamic_with_tools(agents.resolve_model, agents.mock, "planner", "Return the ordered task plan.", [], type_tag<nefor.contracts.Task>(), type_tag<Task>(), 2)
let workers = nefor.dynamic.traverse_template("expand", worker_template, type_tag<Task>(), type_tag<core.types.Result<nefor.contracts.AgentError, WorkerResult>>())

// Dynamic cardinality ends at an effect-aware context node. It waits for the
// explicit completion event and sends one ordered provider turn downstream;
// no runtime-sized MAG List value is invented.
let summary_context = nefor.dynamic.context("summary-input", type_tag<core.types.Result<nefor.contracts.AgentError, WorkerResult>>())
let summarizer = nefor.agents.with_tools(agents.resolve_model, agents.mock, "summarizer", "Summarize the ordered worker results.", [], type_tag<nefor.contracts.ProviderInput>(), type_tag<Summary>(), 2)
let summarize = nefor.node.`>>>`(summary_context, summarizer)

let planned = nefor.node.`>>>`(start, planner)
let ran = nefor.node.`>=>`(planned, nefor.node.lift_result("workers-result", type_tag<nefor.contracts.AgentError>(), workers))
let workflow = nefor.node.`>=>`(ran, summarize)
let result = nefor.graph.output_for("result", workflow)
nefor.artifact.compile((|graph| => nefor.graph.add_edges(graph, [nefor.graph.edge(workflow, result)])): fn(nefor.graph.Graph) -> nefor.graph.Graph)
