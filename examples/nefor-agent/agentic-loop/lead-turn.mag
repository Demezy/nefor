import core.types.{}
// Each user message executes one short-lived lead constellation over the
// persistent canonical chat history. Model selection is resolved by the
// config-owned agents module; the runtime composes ambient system context.
import agents.{}
import nefor.agents.{}
import nefor.artifact.{}
import nefor.contracts.{}
import nefor.graph.{}

let start = nefor.graph.source("lead-task", nefor.contracts.Task {prompt: "<initial task text>"})
let lead = agents.agent<nefor.contracts.Task, nefor.contracts.TextAnswer>("lead", agents.AgentConfig {model: agents.standard, system: "", tools: ["read_file", "read_image", "instructions", "mag-status", "mag-await", "mag-terminate", "write-review", "mag-write-file", "mag-preview", "mag-apply"], tool_approval_policy: nefor.contracts.no_tool_approval_policy(), max_corrections: 2})
let result = nefor.graph.output("lead-output", type_tag<core.types.Result<nefor.contracts.AgentError, nefor.contracts.TextAnswer>>())
let topology: fn(nefor.graph.Graph) -> nefor.graph.Graph = |graph| => nefor.graph.add_edges(graph, [nefor.graph.edge(start, lead), nefor.graph.edge(lead, result)])
nefor.artifact.compile(topology)
