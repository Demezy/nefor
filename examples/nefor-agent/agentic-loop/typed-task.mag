import core.types.{}
// Shipped typed-agent example: the terminal value is either TaskDescription
// or AgentError after the configured correction budget is exhausted.
import agents.{}
import nefor.agents.{}
import nefor.artifact.{}
import nefor.contracts.{}
import nefor.graph.{}

type TaskDescription {task: String, description: String, dependent_tasks: List<String>}

let start = nefor.graph.source("typed-task-input", nefor.contracts.Task {prompt: "Describe the build task"})
let worker = agents.agent<nefor.contracts.Task, TaskDescription>("typed-task", agents.AgentConfig {model: agents.mock, system: "Describe the requested task.", tools: ([]: List<String>), tool_approval_policy: nefor.contracts.no_tool_approval_policy(), max_corrections: 2})
let result = nefor.graph.output("typed-task-output", type_tag<core.types.Result<nefor.contracts.AgentError, TaskDescription>>())
nefor.artifact.compile((|graph| => nefor.graph.add_edges(graph, [nefor.graph.edge(start, worker), nefor.graph.edge(worker, result)])): fn(nefor.graph.Graph) -> nefor.graph.Graph)
