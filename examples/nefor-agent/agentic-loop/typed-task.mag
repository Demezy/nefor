;; Shipped typed-agent example: the terminal value is either TaskDescription
;; or AgentError after the configured correction budget is exhausted.
(require "agents")
(require "nefor.agents")
(require "nefor.artifact")
(require "nefor.contracts")
(require "nefor.graph")

(type TaskDescription {:task String
                       :description String
                       :dependent-tasks (List String)})

(let start (nefor.graph.source "typed-task-input"
              (type-tag nefor.contracts.Task)
              (as nefor.contracts.Task {:prompt "Describe the build task"})))
(let worker (nefor.agents.with-tools agents.resolve-model agents.mock "typed-task"
        "Describe the requested task."
        (as (List String) [])
        (type-tag nefor.contracts.Task)
        (type-tag TaskDescription)
        2))
(let result (nefor.graph.output "typed-task-output"
               (type-tag (| TaskDescription nefor.contracts.AgentError))))
(nefor.artifact.compile
    (fn [[graph nefor.graph.Graph]] -> nefor.graph.Graph
      (nefor.graph.add-edges graph
        [(nefor.graph.edge start worker)
         (nefor.graph.edge worker result)])))
