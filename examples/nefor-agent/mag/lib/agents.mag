import nefor.actors.{}

// This example configuration owns the finite model vocabulary. Nefor only
// asks for one typed resolver; each constructor may author a concrete model or
// a configuration-resolved run profile.
type Model = Standard(Unit) | Mock(Unit)

let standard = named(Model, Standard, nil)

let mock = named(Model, Mock, nil)

let `resolve-model`: fn(Model) -> nefor.actors.AuthoredModel = |model| => match model { case Standard(value) => named(nefor.actors.AuthoredModel, ResolvedModel, nefor.actors.ResolvedModel {provider: "chatgpt", model: "gpt-5.6-sol", `reasoning-effort`: nefor.actors.`reasoning-effort`("medium")}), case Mock(value) => named(nefor.actors.AuthoredModel, ResolvedModel, nefor.actors.ResolvedModel {provider: "mock-provider", model: "mock-model", `reasoning-effort`: nefor.actors.`reasoning-effort`("medium")}) }
