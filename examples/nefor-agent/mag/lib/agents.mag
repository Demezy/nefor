import core.types.{}

import nefor.actors.{}

import nefor.agents.{}

import nefor.contracts.{}

import nefor.dynamic.{}

import nefor.graph.{}

// This example configuration owns the finite model vocabulary. Nefor only
// asks for one typed resolver; each constructor may author a concrete model or
// a configuration-resolved run profile.
type Model = Standard(Unit) | Mock(Unit)

let standard = named(Model, Standard, nil)

let mock = named(Model, Mock, nil)

let resolve_model: fn(Model) -> nefor.actors.AuthoredModel = |model| => match model { case Standard(value) => named(nefor.actors.AuthoredModel, ResolvedModel, nefor.actors.ResolvedModel {provider: "chatgpt", model: "gpt-5.6-sol", reasoning_effort: nefor.actors.reasoning_effort("medium")}), case Mock(value) => named(nefor.actors.AuthoredModel, ResolvedModel, nefor.actors.ResolvedModel {provider: "mock-provider", model: "mock-model", reasoning_effort: nefor.actors.reasoning_effort("medium")}) }

type AgentConfig {model: Model, system: String, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy, max_corrections: Int}

type DynamicTemplateConfig {model: Model, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy, max_corrections: Int}

let agent<I, O>: fn(String, AgentConfig) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> = |id, config| => nefor.actors.agent(id, resolve_model, nefor.actors.AgentConfig<Model> {model: get(config, "model"), system: get(config, "system"), tools: get(config, "tools"), tool_approval_policy: get(config, "tool_approval_policy"), max_corrections: get(config, "max_corrections")}, type_tag<I>(), type_tag<O>())

let dynamic_agent<I, O>: fn(String, AgentConfig) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, nefor.dynamic.DynamicList<O>>> = |id, config| => nefor.actors.dynamic_agent(id, resolve_model, nefor.actors.AgentConfig<Model> {model: get(config, "model"), system: get(config, "system"), tools: get(config, "tools"), tool_approval_policy: get(config, "tool_approval_policy"), max_corrections: get(config, "max_corrections")}, type_tag<I>(), type_tag<O>())

let dynamic_template<O>: fn(String, DynamicTemplateConfig, nefor.dynamic.ValueRef<String>, nefor.dynamic.ValueRef<Int>, nefor.dynamic.ValueRef<String>, nefor.dynamic.ValueRef<String>, nefor.dynamic.ValueRef<String>) -> nefor.dynamic.TemplateNode<Unit, core.types.Result<nefor.contracts.AgentError, O>> = |traversal_id, config, collection_ref, index_ref, worker_id, root_id, system| => nefor.agents.dynamic_template(traversal_id, resolve_model, nefor.agents.DynamicTemplateConfig<Model> {model: get(config, "model"), tools: get(config, "tools"), tool_approval_policy: get(config, "tool_approval_policy"), max_corrections: get(config, "max_corrections")}, collection_ref, index_ref, worker_id, root_id, system, type_tag<O>())
