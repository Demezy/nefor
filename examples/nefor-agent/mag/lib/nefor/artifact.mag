(require "core.validated")
(require "nefor.graph")

;; Authored programs are pure Graph -> Graph transformations. Compilation
;; applies one to empty-graph; the Nefor host interprets the raw artifact as a
;; graph modification and executes it as a fresh run.
(let compile (fn [[transform (Fn nefor.graph.Graph nefor.graph.Graph)]]
                 -> Artifact
  (let graph (transform nefor.graph.empty-graph))
  (let checked (nefor.graph.validate
                  graph
                  (host-input "factory_contracts"
                    (type-tag (List nefor.graph.FactoryContract)))))
  (let checked-tag (get checked "tag"))
  (if (= checked-tag "core.validated.Valid")
      (artifact
        (nefor.graph.lower
          (get (as (core.validated.Valid nefor.graph.Graph) checked)
               "value")))
      (fail checked))))

(let compile-program (fn [[transform (Fn nefor.graph.Graph nefor.graph.Graph)]
                          [rules (List nefor.graph.Rule)]]
                         -> Artifact
  (let graph (transform nefor.graph.empty-graph))
  (let checked (nefor.graph.validate-with-rules
                  graph
                  rules
                  (host-input "factory_contracts"
                    (type-tag (List nefor.graph.FactoryContract)))))
  (let checked-tag (get checked "tag"))
  (if (= checked-tag "core.validated.Valid")
      (artifact
        (nefor.graph.lower-program
          (as nefor.graph.Program
            {:graph (get (as (core.validated.Valid nefor.graph.Graph) checked) "value")
             :rules rules})))
      (fail checked))))

;; A rule result has no result boundary and cannot replace the run's immutable
;; rule subscriptions.
(let delta (fn [[change nefor.graph.Delta]] -> Artifact
  (artifact (nefor.graph.lower-delta change))))
