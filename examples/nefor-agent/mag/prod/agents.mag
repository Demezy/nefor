(require "nefor.actors")
(require "nefor.contracts")
(require "nefor.graph")

;; The built-in CLI production config owns its model vocabulary and resolves
;; each typed choice to the concrete parameters the runtime executes.
(type Fast {})
(type Standard {})
(type Deep {})
(type Max {})
(type Model (| Fast Standard Deep Max))

(let fast (as Model (as Fast {})))
(let standard (as Model (as Standard {})))
(let deep (as Model (as Deep {})))
(let max (as Model (as Max {})))

(let resolve-model (fn [[model Model]] -> nefor.actors.ResolvedModel
  (match model
    [Fast value
      (as nefor.actors.ResolvedModel
        {:provider "ollama" :model "qwen3.6:35b-a3b-coding-mxfp8"
         :reasoning-effort "low"})]
    [Standard value
      (as nefor.actors.ResolvedModel
        {:provider "ollama" :model "qwen3.6:35b-a3b-coding-mxfp8"
         :reasoning-effort "medium"})]
    [Deep value
      (as nefor.actors.ResolvedModel
        {:provider "ollama" :model "qwen3.6:35b-a3b-coding-mxfp8"
         :reasoning-effort "high"})]
    [Max value
      (as nefor.actors.ResolvedModel
        {:provider "ollama" :model "qwen3.6:35b-a3b-coding-mxfp8"
         :reasoning-effort "xhigh"})])))

(let with-tools (fn [I O] [[model Model] [id String] [system String]
                            [tools (List String)]
                            [input-type (TypeTag I)] [output-type (TypeTag O)]
                            [max-corrections Int]]
  -> (nefor.graph.Node I (| O nefor.contracts.AgentError))
  (nefor.actors.agent resolve-model
    (as (nefor.actors.AgentConfig Model)
      {:id id :model model :system system :tools tools
       :da-policy (nefor.contracts.no-da-policy)
       :max-corrections max-corrections})
    input-type output-type)))
