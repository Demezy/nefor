import nefor.artifact.{}
import nefor.contracts.{}
import nefor.graph.{}
import nefor.shell.{}

// Edge identity is logical endpoints plus route, but duplicate identities must
// not erase evidence that one node id denotes divergent immutable definitions.
let start = nefor.graph.source("start", type_tag<Unit>(), nil)
let `operation-a` = nefor.shell.script("operation", nefor.shell.ShellScriptParams {script: "printf a", cwd: ".", timeout: nefor.contracts.`no-timeout`()})
let `operation-b` = nefor.shell.script("operation", nefor.shell.ShellScriptParams {script: "printf b", cwd: ".", timeout: nefor.contracts.`no-timeout`()})
let result = nefor.graph.`output-for`("result", `operation-a`)
nefor.artifact.compile((|base| => nefor.graph.`add-edges`(base, [nefor.graph.edge(start, `operation-a`), nefor.graph.edge(start, `operation-b`), nefor.graph.edge(`operation-a`, result)])): fn(nefor.graph.Graph) -> nefor.graph.Graph)
