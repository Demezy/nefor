import nefor.artifact.{}
import nefor.graph.{}

// A root has no upstream value. Its input must therefore accept the
// topology-derived Unit activation.
let unfed = nefor.graph.identity<String>("unfed")
let result = nefor.graph.output_for("result", unfed)
nefor.artifact.compile((|graph| => nefor.graph.add_edges(graph, [nefor.graph.edge(unfed, result)])): fn(nefor.graph.Graph) -> nefor.graph.Graph)
