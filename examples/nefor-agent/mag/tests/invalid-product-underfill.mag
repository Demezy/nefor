(require "nefor.artifact")
(require "nefor.contracts")
(require "nefor.graph")

(let left (nefor.graph.source "left" (type-tag nefor.contracts.Text)
             (as nefor.contracts.Text {:content "left"})))
(let input (nefor.graph.port "join"
              (type-tag (+ nefor.contracts.Text nefor.contracts.Text))
              "test.Value"))
(let output (nefor.graph.port "join" (type-tag nefor.contracts.Text) "test.Value"))
(let worker (nefor.graph.actor "join" "test.product"
               [(type-evidence (type-tag nefor.contracts.Text))] nil
               (nefor.graph.store-port input) [(nefor.graph.store-port output)]))
(let join (nefor.graph.node "join" "ordinary" [worker]
             (as (List nefor.graph.StoredRoute) [])
             (as (List nefor.graph.Message) []) input output))
(let result (nefor.graph.output "result" (type-tag nefor.contracts.Text)))
(nefor.artifact.compile
    (fn [[base nefor.graph.Graph]] -> nefor.graph.Graph
      (nefor.graph.add-edges base
        [(nefor.graph.edge left join)
         (nefor.graph.edge join result)])))
