import nefor.artifact.{}
import nefor.contracts.{}
import nefor.graph.{}
import nefor.shell.{}

// A role string cannot turn an ordinary actor into the concrete source
// boundary. Source authority comes from its factory and exact node shape.
let ordinary = nefor.shell.script("fake-source", nefor.shell.ShellScriptParams {script: "printf fake", cwd: ".", timeout: named(nefor.contracts.Timeout, Unlimited, nil)})
let fake_source = nefor.graph.node(get(ordinary, "id"), "source", get(ordinary, "actors"), get(ordinary, "routes"), get(ordinary, "messages"), get(ordinary, "input"), get(ordinary, "output"))
let result = nefor.graph.output_for("result", fake_source)
nefor.artifact.compile((|base| => nefor.graph.add_edges(base, [nefor.graph.edge(fake_source, result)])): fn(nefor.graph.Graph) -> nefor.graph.Graph)
