import nefor.artifact.{}
import nefor.graph.{}
import nefor.node.{}

type Left {value: Int}
type Right {value: String}
type Choice = Left(Left) | Right(Right)

let start = nefor.graph.source("start", named(Choice, Left, Left {value: 1}))
let split_input = nefor.graph.port("split", type_tag<Choice>(), "nefor.adt.Value")
let split_left = nefor.graph.port("split", type_tag<Left>(), "nefor.adt.First")
let split_right = nefor.graph.port("split", type_tag<Right>(), "nefor.adt.Second")
let split_actor = nefor.graph.actor("split", "nefor.factory.adt-unpack", [type_evidence(type_tag<Choice>()), type_evidence(type_tag<Left>()), type_evidence(type_tag<Right>())], nefor.node.AdtUnpackParams {owner: type_evidence(type_tag<Choice>()), left_payload: type_evidence(type_tag<Left>()), right_payload: type_evidence(type_tag<Right>()), left_constructor: "Left", right_constructor: "Right"}, nefor.graph.store_port(split_input), [nefor.graph.store_port(split_left), nefor.graph.store_port(split_right)])
let split = nefor.graph.node("split", "ordinary", [split_actor], ([]: List<nefor.graph.StoredRoute>), ([]: List<nefor.graph.Message>), split_input, split_left)
let input = nefor.graph.port("left", type_tag<Left>(), "test.Value")
let output = nefor.graph.port("left", type_tag<Left>(), "test.Value")
let worker = nefor.graph.actor("left", "test.left", [], nil, nefor.graph.store_port(input), [nefor.graph.store_port(output)])
let left = nefor.graph.node("left", "ordinary", [worker], ([]: List<nefor.graph.StoredRoute>), ([]: List<nefor.graph.Message>), input, output)
let result = nefor.graph.output("result", type_tag<Left>())
nefor.artifact.compile((|base| => nefor.graph.add_edges(base, [nefor.graph.edge(start, split), nefor.graph.edge(split, left), nefor.graph.edge(left, result)])): fn(nefor.graph.Graph) -> nefor.graph.Graph)
