(require "nefor.artifact")
(require "nefor.graph")
(require "nefor.node")

(type Left {:value Int})
(type Right {:value String})
(type Choice (adt [Left Left] [Right Right]))

(let start (nefor.graph.source "start" (type-tag Choice)
              (construct Choice Left (as Left {:value 1}))))
(let split-input (nefor.graph.port "split" (type-tag Choice) "nefor.adt.Value"))
(let split-left (nefor.graph.port "split" (type-tag Left) "nefor.adt.First"))
(let split-right (nefor.graph.port "split" (type-tag Right) "nefor.adt.Second"))
(let split-actor
  (nefor.graph.actor "split" "nefor.factory.adt-unpack"
    [(type-evidence (type-tag Choice))
     (type-evidence (type-tag Left))
     (type-evidence (type-tag Right))]
    (as nefor.node.AdtUnpackParams
      {:owner (type-evidence (type-tag Choice))
       :left_payload (type-evidence (type-tag Left))
       :right_payload (type-evidence (type-tag Right))
       :left_constructor "Left" :right_constructor "Right"})
    (nefor.graph.store-port split-input)
    [(nefor.graph.store-port split-left) (nefor.graph.store-port split-right)]))
(let split (nefor.graph.node "split" "ordinary" [split-actor]
             (as (List nefor.graph.StoredRoute) [])
             (as (List nefor.graph.Message) [])
             split-input split-left))
(let input (nefor.graph.port "left" (type-tag Left) "test.Value"))
(let output (nefor.graph.port "left" (type-tag Left) "test.Value"))
(let worker (nefor.graph.actor "left" "test.left" [] nil
               (nefor.graph.store-port input)
               [(nefor.graph.store-port output)]))
(let left (nefor.graph.node "left" "ordinary" [worker]
             (as (List nefor.graph.StoredRoute) [])
             (as (List nefor.graph.Message) [])
             input output))
(let result (nefor.graph.output "result" (type-tag Left)))
(nefor.artifact.compile
    (fn [[base nefor.graph.Graph]] -> nefor.graph.Graph
      (nefor.graph.add-edges base
        [(nefor.graph.edge start split)
         (nefor.graph.edge split left)
         (nefor.graph.edge left result)])))
