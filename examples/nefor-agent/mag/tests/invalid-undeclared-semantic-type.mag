import nefor.actors.{}
import nefor.contracts.{}

let exact_model: fn(nefor.actors.ResolvedModel) -> nefor.actors.AuthoredModel = |model| => named(nefor.actors.AuthoredModel, ResolvedModel, model)
let resolved_model_value = nefor.actors.ResolvedModel {provider: "mock-plugin", model: "mock-model", reasoning_effort: nefor.actors.reasoning_effort("medium")}

nefor.actors.agent("invalid", exact_model, nefor.actors.AgentConfig<nefor.actors.ResolvedModel> {model: resolved_model_value, system: "", tools: [], tool_approval_policy: nefor.contracts.no_tool_approval_policy(), max_corrections: 0}, type_tag<nefor.contracts.Task>(), type_tag<MissingSemanticType>())
