import nefor.actors.{}
import nefor.contracts.{}

let `exact-model`: fn(nefor.actors.ResolvedModel) -> nefor.actors.ResolvedModel = |model| => model
let `resolved-model-value` = nefor.actors.ResolvedModel {provider: "mock-plugin", model: "mock-model", `reasoning-effort`: nefor.actors.`reasoning-effort`("medium")}

nefor.actors.`resolved-agent`(`exact-model`, nefor.actors.AgentConfig<nefor.actors.ResolvedModel> {id: "invalid", model: `resolved-model-value`, system: "", tools: [], `da-policy`: nefor.contracts.`no-da-policy`(), `max-corrections`: 0}, type_tag<nefor.contracts.Task>(), type_tag<MissingSemanticType>())
