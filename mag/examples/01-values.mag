import core.map as maps

type ExampleValues {unit: Unit, bool: Bool, int: Int, float: Float, string: String, list: List<Int>, map: Map<String, Int>}
type ExampleArtifact {record: ExampleValues, copied: List<Int>}

let record = ExampleValues {
  unit: nil,
  bool: true,
  int: 3,
  float: 3.5,
  string: "MAG",
  list: [1, 2, 3],
  map: maps.insert(maps.insert(maps.empty<String, Int>(), "one", 1), "two", 2)
}

// Collection transforms return new values; numbers remains [1, 2, 3].
let numbers = [1, 2, 3]
let copied = map(((|value| => value): fn(Int) -> Int), numbers)

artifact(ExampleArtifact {record: record, copied: copied})
