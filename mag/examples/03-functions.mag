(type Entry [K V] {:key K :value V})
(type NamedValue {:name String :value Int})

;; Both type parameters are inferred from a call such as
;; (entry "answer" 42), which returns Entry String Int.
(let entry (fn [K V] [[key K] [value V]] -> (Entry K V)
  (as (Entry K V) {:key key :value value})))

;; A regular helper can itself be passed into a higher-order operation.
(let label (fn [[name String] [value Int]] -> NamedValue
  (as NamedValue {:name name :value value})))

(let names ["one" "two" "three"])
(let entries (indexed-map
                (fn [[index Int] [name String]] -> NamedValue
                  (label name index))
                names))

(artifact {:entry (entry "answer" 42)
           :entries entries})
