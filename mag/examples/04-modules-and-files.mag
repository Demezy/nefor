import modules.labels.{}

type ExampleArtifact {title: String, source: String, project: String, label: String}

// Required bindings live in the module's qualified namespace.
let title = modules.labels.title

// File inputs become immutable values in the loaded source snapshot.
let source = read("data/note.md")
let manifest = read_json("data/manifest.json")
let project_name: String = (get(manifest, "project"): String)

artifact(ExampleArtifact {title: title, source: source, project: project_name, label: modules.labels.number_label(4)})
