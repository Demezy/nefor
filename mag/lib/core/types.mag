// Small algebraic types shared by MAG libraries. These are ordinary nominal
// data types; the evaluator has no special knowledge of them.
type Option<T> = Some(T) | None(Unit)

type Either<L, R> = Left(L) | Right(R)

type Result<E, T> = Ok(T) | Error(E)

let some<T>: fn(T) -> Option<T> = |value| => named(Option<T>, Some, value)

let none<T>: fn() -> Option<T> = | | => named(Option<T>, None, nil)

let left<L, R>: fn(L) -> Either<L, R> = |value| => named(Either<L, R>, Left, value)

let right<L, R>: fn(R) -> Either<L, R> = |value| => named(Either<L, R>, Right, value)

let ok<E, T>: fn(T) -> Result<E, T> = |value| => named(Result<E, T>, Ok, value)

let error<E, T>: fn(E) -> Result<E, T> = |value| => named(Result<E, T>, Error, value)

let `option-map`<T, U>: fn(fn(T) -> U, Option<T>) -> Option<U> = |f, option| => match option { case Some(present) => named(Option<U>, Some, f(present)), case None(absent) => named(Option<U>, None, nil) }

let `either-map`<L, T, U>: fn(fn(T) -> U, Either<L, T>) -> Either<L, U> = |f, either| => match either { case Left(`left-value`) => named(Either<L, U>, Left, `left-value`), case Right(`right-value`) => named(Either<L, U>, Right, f(`right-value`)) }

let `result-map`<E, T, U>: fn(fn(T) -> U, Result<E, T>) -> Result<E, U> = |f, result| => match result { case Error(failure) => named(Result<E, U>, Error, failure), case Ok(value) => named(Result<E, U>, Ok, f(value)) }

let `result-and-then`<E, T, U>: fn(fn(T) -> Result<E, U>, Result<E, T>) -> Result<E, U> = |f, result| => match result { case Error(failure) => named(Result<E, U>, Error, failure), case Ok(value) => f(value) }
