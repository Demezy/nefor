;; Small algebraic types shared by MAG libraries. These are ordinary nominal
;; data types; the evaluator has no special knowledge of them.

(type Some [T] {:value T})
(type None {})
(type Option [T] (| (Some T) None))

(type Left [L] {:value L})
(type Right [R] {:value R})
(type Either [L R] (| (Left L) (Right R)))

(let some (fn [T] [[value T]] -> (Some T)
  (as (Some T) {:value value})))
(let none (fn [] -> None (as None {})))
(let left (fn [L] [[value L]] -> (Left L)
  (as (Left L) {:value value})))
(let right (fn [R] [[value R]] -> (Right R)
  (as (Right R) {:value value})))

(let option-map (fn [T U] [[f (Fn T U)] [option (Option T)]] -> (Option U)
  (match option
    [(Some T) present
      (as (Option U) (as (Some U) {:value (f (get present "value"))}))]
    [None absent (as (Option U) (as None {}))])))

(let either-map (fn [L T U] [[f (Fn T U)] [either (Either L T)]] -> (Either L U)
  (match either
    [(Left L) left-value
      (as (Either L U) (as (Left L) {:value (get left-value "value")}))]
    [(Right T) right-value
      (as (Either L U) (as (Right U) {:value (f (get right-value "value"))}))])))
