(require "core.types")

;; Validation is a library algebra, not a distinguished evaluator result.
(type ValidationErrors [E] {:errors (List E)})
(type Validated [E T] (adt [Valid T] [Invalid (ValidationErrors E)]))

(let valid (fn [E T] [[value T]] -> (Validated E T)
  (construct (Validated E T) Valid value)))

(let invalid (fn [E T] [[errors (List E)]] -> (Validated E T)
  (construct (Validated E T) Invalid
    (as (ValidationErrors E) {:errors errors}))))

(let valid? (fn [E T] [[validated (Validated E T)]] -> Bool
  (match validated
    [Valid accepted true]
    [Invalid rejected false])))

(let map (fn [E T U] [[f (Fn T U)] [validated (Validated E T)]] -> (Validated E U)
  (match validated
    [Valid accepted (construct (Validated E U) Valid (f accepted))]
    [Invalid rejected (construct (Validated E U) Invalid rejected)])))

(let and-then (fn [E T U] [[f (Fn T (Validated E U))]
                            [validated (Validated E T)]] -> (Validated E U)
  (match validated
    [Valid accepted (f accepted)]
    [Invalid rejected (construct (Validated E U) Invalid rejected)])))
