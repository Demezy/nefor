import core.types.{}

import nefor.graph.{}

import nefor.mag.{}

import nefor.contracts.{}

import nefor.dynamic.{}

let adapter_factory = "nefor.factory.adapter"

let llm_factory = "nefor.factory.llm"

let structured_output_factory = "nefor.factory.structured-output"

let run_tool_factory = "nefor.factory.run-tool"

let tool_result_factory = "nefor.factory.tool-result"

let retry_gate_factory = "nefor.factory.retry-gate"

let human_factory = "nefor.factory.human"

type AdapterParams {seed: String, schema: TypeSchema}

type OptionalReasoningEffort {present: Bool, value: String}

type OptionalModelProfile {present: Bool, value: String}

let reasoning_effort: fn(String) -> OptionalReasoningEffort = |value| => OptionalReasoningEffort {present: true, value: value}

let no_reasoning_effort = OptionalReasoningEffort {present: false, value: ""}

type ModelProfile {name: String}

let model_profile: fn(String) -> ModelProfile = |name| => ModelProfile {name: name}

let no_model_profile = OptionalModelProfile {present: false, value: ""}

let selected_model_profile: fn(ModelProfile) -> OptionalModelProfile = |profile| => OptionalModelProfile {present: true, value: get(profile, "name")}

type ResolvedModel {provider: String, model: String, reasoning_effort: OptionalReasoningEffort}

type AuthoredModel = ResolvedModel(ResolvedModel) | ModelProfile(ModelProfile)

type LlmParams {model: String, provider: String, reasoning_effort: OptionalReasoningEffort, model_profile: OptionalModelProfile, system: String, tools: List<String>, output_type: SemanticTypeId, error_type: SemanticTypeId, provider_error_type: SemanticTypeId}

type StructuredOutputParams {model: String, provider: String, reasoning_effort: OptionalReasoningEffort, model_profile: OptionalModelProfile, system: String, tools: List<String>, schema: TypeSchema, output_type: SemanticTypeId, error_type: SemanticTypeId, provider_error_type: SemanticTypeId, validation_error_type: SemanticTypeId, max_corrections: Int, dynamic: Bool, dynamic_item_type: SemanticTypeId, dynamic_item_descriptor: TypeDescriptor}

type RunToolParams {model: String, provider: String, model_profile: OptionalModelProfile, conversation_peer: String, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy}

type ToolResultParams {}

type RetryGateParams {max_retries: Int}

type HumanParams {prompt: String}

type AgentConfig<M> {model: M, system: String, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy, max_corrections: Int}

type ApprovalConfig {prompt: String}

type RetryGateConfig {max_retries: Int}

// Every agent has one public nominal Result<AgentError, O> port. Workflows
// continue successful values with the ordinary result combinators and preserve
// AgentError as an explicit alternative.
let agent_with_schema<M, I, O>: fn(String, fn(M) -> AuthoredModel, AgentConfig<M>, TypeTag<I>, TypeTag<O>, TypeSchema, Bool, SemanticTypeId, TypeDescriptor) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> = |id, resolve_model, config, input_type, output_type, schema, dynamic, dynamic_item_type, dynamic_item_descriptor| => {
  let authored_model = resolve_model(get(config, "model"))
  let resolved_model = match authored_model { case ResolvedModel(value) => value, case ModelProfile(value) => ResolvedModel {provider: "", model: "", reasoning_effort: no_reasoning_effort} }
  let selected_profile = match authored_model { case ResolvedModel(value) => no_model_profile, case ModelProfile(value) => selected_model_profile(value) }
  let entry_id = str(id, ".entry")
  let llm_id = str(id, ".llm")
  let run_tool_id = str(id, ".run-tool")
  let tool_result_id = str(id, ".tool-result")
  // ProviderInput is already a complete provider turn, so it continues
  // unchanged. Every other semantic type starts a fresh typed user turn.
  // The runtime wire is derived here and is not part of the authoring API.
  let input_wire = if (=)(canonical(type_id(type_evidence(input_type))), canonical(type_id(type_evidence(type_tag<nefor.contracts.ProviderInput>())))) then "generic-provider.ProviderOut" else "nefor.agent.Input"
  let entry_in = nefor.graph.port(entry_id, input_type, input_wire)
  let entry_out = nefor.graph.port(entry_id, type_tag<nefor.contracts.ProviderInput>(), "generic-provider.ProviderOut")
  let llm_in = nefor.graph.port(llm_id, type_tag<nefor.contracts.ProviderInput>(), "generic-provider.ProviderOut")
  let tool_calls = nefor.graph.port(llm_id, type_tag<nefor.contracts.ToolCalls>(), "generic-tool.ToolCalls")
  let result = nefor.graph.port(llm_id, type_tag<core.types.Result<nefor.contracts.AgentError, O>>(), "nefor.agent.Result")
  let run_in = nefor.graph.port(run_tool_id, type_tag<nefor.contracts.ToolCalls>(), "generic-tool.ToolCalls")
  let run_out = nefor.graph.port(run_tool_id, type_tag<nefor.contracts.ToolHandle>(), "generic-tool.ToolHandle")
  let result_in = nefor.graph.port(tool_result_id, type_tag<nefor.contracts.ToolHandle>(), "generic-tool.ToolHandle")
  let result_out = nefor.graph.port(tool_result_id, type_tag<nefor.contracts.ProviderInput>(), "generic-provider.ProviderOut")
  nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> {id: id, role: "ordinary", actors: [nefor.graph.actor(entry_id, adapter_factory, [type_evidence(input_type)], AdapterParams {seed: "provider-in", schema: type_schema(input_type)}, nefor.graph.store_port(entry_in), [nefor.graph.store_port(entry_out)]), if if not(dynamic) then (=)(canonical(type_id(type_evidence(output_type))), canonical(type_id(type_evidence(type_tag<nefor.contracts.TextAnswer>())))) else false then nefor.graph.actor(llm_id, llm_factory, [type_evidence(type_tag<core.types.Result<nefor.contracts.AgentError, O>>())], LlmParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), reasoning_effort: get(resolved_model, "reasoning_effort"), model_profile: selected_profile, system: get(config, "system"), tools: or(get(config, "tools"), ([]: List<String>)), output_type: type_id(type_evidence(output_type)), error_type: type_id(type_evidence(type_tag<nefor.contracts.AgentError>())), provider_error_type: type_id(type_evidence(type_tag<nefor.contracts.ProviderError>()))}, nefor.graph.store_port(llm_in), [nefor.graph.store_port(tool_calls), nefor.graph.store_port(result)]) else nefor.graph.actor(llm_id, structured_output_factory, [type_evidence(output_type), type_evidence(type_tag<core.types.Result<nefor.contracts.AgentError, O>>())], if dynamic then StructuredOutputParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), reasoning_effort: get(resolved_model, "reasoning_effort"), model_profile: selected_profile, system: get(config, "system"), tools: or(get(config, "tools"), ([]: List<String>)), schema: schema, dynamic: dynamic, output_type: type_id(type_evidence(output_type)), error_type: type_id(type_evidence(type_tag<nefor.contracts.AgentError>())), provider_error_type: type_id(type_evidence(type_tag<nefor.contracts.ProviderError>())), validation_error_type: type_id(type_evidence(type_tag<nefor.contracts.OutputValidationError>())), max_corrections: get(config, "max_corrections"), dynamic_item_type: dynamic_item_type, dynamic_item_descriptor: dynamic_item_descriptor} else StructuredOutputParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), reasoning_effort: get(resolved_model, "reasoning_effort"), model_profile: selected_profile, system: get(config, "system"), tools: or(get(config, "tools"), ([]: List<String>)), schema: schema, output_type: type_id(type_evidence(output_type)), error_type: type_id(type_evidence(type_tag<nefor.contracts.AgentError>())), provider_error_type: type_id(type_evidence(type_tag<nefor.contracts.ProviderError>())), validation_error_type: type_id(type_evidence(type_tag<nefor.contracts.OutputValidationError>())), max_corrections: get(config, "max_corrections"), dynamic: dynamic, dynamic_item_type: dynamic_item_type, dynamic_item_descriptor: dynamic_item_descriptor}, nefor.graph.store_port(llm_in), [nefor.graph.store_port(tool_calls), nefor.graph.store_port(result)]), nefor.graph.actor(run_tool_id, run_tool_factory, [], RunToolParams {model: get(resolved_model, "model"), provider: get(resolved_model, "provider"), model_profile: selected_profile, conversation_peer: llm_id, tools: or(get(config, "tools"), ([]: List<String>)), tool_approval_policy: get(config, "tool_approval_policy")}, nefor.graph.store_port(run_in), [nefor.graph.store_port(run_out)]), nefor.graph.actor(tool_result_id, tool_result_factory, [], ToolResultParams {}, nefor.graph.store_port(result_in), [nefor.graph.store_port(result_out)])], routes: [nefor.graph.stored_route(entry_out, llm_in), nefor.graph.stored_route(tool_calls, run_in), nefor.graph.stored_route(run_out, result_in), nefor.graph.stored_route(result_out, llm_in)], messages: [], operations: [], nodes: [nefor.graph.logical_node([id], []), nefor.graph.logical_node([id, "entry"], [entry_id]), nefor.graph.logical_node([id, "llm"], [llm_id]), nefor.graph.logical_node([id, "run-tool"], [run_tool_id]), nefor.graph.logical_node([id, "tool-result"], [tool_result_id])], input: entry_in, output: result}
}

let agent<M, I, O>: fn(String, fn(M) -> AuthoredModel, AgentConfig<M>, TypeTag<I>, TypeTag<O>) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, O>> = |id, resolve_model, config, input_type, output_type| => agent_with_schema(id, resolve_model, config, input_type, output_type, type_schema(output_type), false, type_id(type_evidence(output_type)), type_evidence(output_type))

let dynamic_agent<M, I, O>: fn(String, fn(M) -> AuthoredModel, AgentConfig<M>, TypeTag<I>, TypeTag<O>) -> nefor.graph.Node<I, core.types.Result<nefor.contracts.AgentError, nefor.dynamic.DynamicList<O>>> = |id, resolve_model, config, input_type, item_type| => agent_with_schema(id, resolve_model, config, input_type, type_tag<nefor.dynamic.DynamicList<O>>(), type_schema(type_tag<List<O>>()), true, type_id(type_evidence(item_type)), type_evidence(item_type))

// Base toolset shorthands for common delegated-agent capability profiles.
// Explicit custom :tools lists remain the right shape for narrower
// roles or config-specific tools.
import nefor.toolsets.{}

let read_only_tools = nefor.toolsets.read_only

let general_tools = nefor.toolsets.general

let retry_gate<T>: fn(String, RetryGateConfig, TypeTag<T>) -> nefor.graph.Node<T, nefor.contracts.RetryDecision<T>> = |id, config, `type`| => {
  let actor_id = str(id, ".retry-gate")
  let input = nefor.graph.port(actor_id, `type`, "nefor.retry.Input")
  let result = nefor.graph.port(actor_id, type_tag<nefor.contracts.RetryDecision<T>>(), "nefor.retry.Result")
  nefor.graph.node_with_operations_and_nodes(id, "ordinary", [nefor.graph.actor(actor_id, retry_gate_factory, [type_evidence(`type`), type_evidence(type_tag<nefor.contracts.RetryDecision<T>>())], RetryGateParams {max_retries: get(config, "max_retries")}, nefor.graph.store_port(input), [nefor.graph.store_port(result)])], [], [], [], [nefor.graph.logical_node([id], [actor_id])], input, result)
}

let approval_gate: fn(String, ApprovalConfig) -> nefor.graph.Node<nefor.contracts.TextAnswer, nefor.contracts.ApprovalDecision> = |id, config| => {
  let actor_id = str(id, ".human")
  let input = nefor.graph.port(actor_id, type_tag<nefor.contracts.TextAnswer>(), "generic-provider.TextAnswer")
  let result = nefor.graph.port(actor_id, type_tag<nefor.contracts.ApprovalDecision>(), "human.Decision")
  nefor.graph.node_with_operations_and_nodes(id, "ordinary", [nefor.graph.actor(actor_id, human_factory, [type_evidence(type_tag<nefor.contracts.ApprovalDecision>())], HumanParams {prompt: get(config, "prompt")}, nefor.graph.store_port(input), [nefor.graph.store_port(result)])], [], [], [], [nefor.graph.logical_node([id], [actor_id])], input, result)
}
