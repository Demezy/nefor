(require "nefor.graph")
(require "nefor.contracts")
(require "nefor.dynamic")

(let adapter-factory "nefor.factory.adapter")
(let llm-factory "nefor.factory.llm")
(let structured-output-factory "nefor.factory.structured-output")
(let run-tool-factory "nefor.factory.run-tool")
(let tool-result-factory "nefor.factory.tool-result")
(let retry-gate-factory "nefor.factory.retry-gate")
(let human-factory "nefor.factory.human")

(type AdapterParams {:seed String :schema TypeSchema})
(type ResolvedModel {:provider String
                     :model String
                     :reasoning-effort String})
(type LlmParams {:model String
                 :provider String
                 :reasoning_effort String
                 :system String
                 :tools (List String)
                 :output_type SemanticTypeId
                 :error_type SemanticTypeId
                 :provider_error_type SemanticTypeId})
(type StructuredOutputParams {:model String
                              :provider String
                              :reasoning_effort String
                              :system String
                              :tools (List String)
                              :schema TypeSchema
                              :output_type SemanticTypeId
                              :error_type SemanticTypeId
                              :provider_error_type SemanticTypeId
                              :validation_error_type SemanticTypeId
                              :max_corrections Int})
(type DynamicStructuredOutputParams {:model String
                                     :provider String
                                     :reasoning_effort String
                                     :system String
                                     :tools (List String)
                                     :schema TypeSchema
                                     :output_type SemanticTypeId
                                     :error_type SemanticTypeId
                                     :provider_error_type SemanticTypeId
                                     :validation_error_type SemanticTypeId
                                     :max_corrections Int
                                     :dynamic_item_type SemanticTypeId
                                     :dynamic_item_descriptor TypeDescriptor})
(type RunToolParams {:tools (List String)
                     :da-policy nefor.contracts.DaPolicy})
(type ToolResultParams {})
(type RetryGateParams {:max_retries Int})
(type HumanParams {:prompt String})

(type AgentConfig [M] {:id String
                   :model M
                   :system String
                   :tools (List String)
                   :da-policy nefor.contracts.DaPolicy
                   :max-corrections Int})
(type ApprovalConfig {:id String :prompt String})
(type RetryGateConfig {:id String :max-retries Int})

(let task-source (fn [[id String] [prompt String]]
  -> (nefor.graph.Node Unit nefor.contracts.Task)
  (nefor.graph.source id
    (type-tag nefor.contracts.Task)
    (as nefor.contracts.Task {:prompt prompt}))))

;; Every agent has one public result port with semantic type `O | AgentError`.
;; The stable result wire carries the selected constructor identity. Ordinary
;; edges route compatible arms directly; `result-arm` creates a typed resident
;; subscription on that same actor/wire without inserting a selector actor.
(let agent-with-schema (fn [M I O] [[resolve-model (Fn M ResolvedModel)]
                [config (AgentConfig M)] [input-type (TypeTag I)]
                [output-type (TypeTag O)] [schema TypeSchema]
                [dynamic Bool] [dynamic-item-type SemanticTypeId]
                [dynamic-item-descriptor TypeDescriptor]]
  -> (nefor.graph.Node I (| O nefor.contracts.AgentError))
  (let id (get config "id"))
  (let resolved-model (resolve-model (get config "model")))
  (let entry-id (str id ".entry"))
  (let llm-id (str id ".llm"))
  (let run-tool-id (str id ".run-tool"))
  (let tool-result-id (str id ".tool-result"))
  ;; ProviderInput is already a complete provider turn, so it continues
  ;; unchanged. Every other semantic type starts a fresh typed user turn.
  ;; The runtime wire is derived here and is not part of the authoring API.
  (let input-wire
    (if (= (type-id (type-evidence input-type))
           (type-id
             (type-evidence (type-tag nefor.contracts.ProviderInput))))
      "generic-provider.ProviderOut"
      "nefor.agent.Input"))
  (let entry-in (nefor.graph.port entry-id input-type input-wire))
  (let entry-out (nefor.graph.port entry-id
                    (type-tag nefor.contracts.ProviderInput)
                    "generic-provider.ProviderOut"))
  (let llm-in (nefor.graph.port llm-id
                  (type-tag nefor.contracts.ProviderInput)
                  "generic-provider.ProviderOut"))
  (let tool-calls (nefor.graph.port llm-id
                     (type-tag nefor.contracts.ToolCalls)
                     "generic-tool.ToolCalls"))
  (let result (nefor.graph.port llm-id
                 (type-tag (| O nefor.contracts.AgentError))
                 "nefor.agent.Result"))
  (let run-in (nefor.graph.port run-tool-id
                 (type-tag nefor.contracts.ToolCalls)
                 "generic-tool.ToolCalls"))
  (let run-out (nefor.graph.port run-tool-id
                  (type-tag nefor.contracts.ToolHandle)
                  "generic-tool.ToolHandle"))
  (let result-in (nefor.graph.port tool-result-id
                    (type-tag nefor.contracts.ToolHandle)
                    "generic-tool.ToolHandle"))
  (let result-out (nefor.graph.port tool-result-id
                     (type-tag nefor.contracts.ProviderInput)
                     "generic-provider.ProviderOut"))
  (as (nefor.graph.Node I (| O nefor.contracts.AgentError)) {:id id :role "ordinary" :actors
       [(nefor.graph.actor entry-id adapter-factory [(type-evidence input-type)]
         (as AdapterParams
           {:seed "provider-in" :schema (type-schema input-type)})
         (nefor.graph.store-port entry-in)
         [(nefor.graph.store-port entry-out)])
       (if (if (not dynamic)
             (= (type-id (type-evidence output-type))
                (type-id (type-evidence (type-tag nefor.contracts.TextAnswer))))
             false)
         (nefor.graph.actor llm-id llm-factory []
           (as LlmParams {:model (get resolved-model "model")
            :provider (get resolved-model "provider")
            :reasoning_effort (get resolved-model "reasoning-effort")
            :system (get config "system")
            :tools (or (get config "tools") (as (List String) []))
            :output_type (type-id (type-evidence output-type))
            :error_type
              (type-id (type-evidence (type-tag nefor.contracts.AgentError)))
            :provider_error_type
              (type-id (type-evidence (type-tag nefor.contracts.ProviderError)))})
           (nefor.graph.store-port llm-in)
           [(nefor.graph.store-port tool-calls)
            (nefor.graph.store-port result)])
         (nefor.graph.actor llm-id structured-output-factory
           [(type-evidence output-type)]
           (if dynamic
             (as DynamicStructuredOutputParams
               {:model (get resolved-model "model")
                :provider (get resolved-model "provider")
                :reasoning_effort (get resolved-model "reasoning-effort")
                :system (get config "system")
                :tools (or (get config "tools") (as (List String) []))
                :schema schema
                :output_type (type-id (type-evidence output-type))
                :error_type
                  (type-id (type-evidence (type-tag nefor.contracts.AgentError)))
                :provider_error_type
                  (type-id (type-evidence (type-tag nefor.contracts.ProviderError)))
                :validation_error_type
                  (type-id
                    (type-evidence (type-tag nefor.contracts.OutputValidationError)))
                :max_corrections (get config "max-corrections")
                :dynamic_item_type dynamic-item-type
                :dynamic_item_descriptor dynamic-item-descriptor})
             (as StructuredOutputParams {:model (get resolved-model "model")
            :provider (get resolved-model "provider")
            :reasoning_effort (get resolved-model "reasoning-effort")
            :system (get config "system")
            :tools (or (get config "tools") (as (List String) []))
            :schema schema
            :output_type (type-id (type-evidence output-type))
            :error_type
              (type-id (type-evidence (type-tag nefor.contracts.AgentError)))
            :provider_error_type
              (type-id (type-evidence (type-tag nefor.contracts.ProviderError)))
            :validation_error_type
              (type-id
                (type-evidence (type-tag nefor.contracts.OutputValidationError)))
            :max_corrections (get config "max-corrections")}))
           (nefor.graph.store-port llm-in)
           [(nefor.graph.store-port tool-calls)
            (nefor.graph.store-port result)]))
       (nefor.graph.actor run-tool-id run-tool-factory []
         (as RunToolParams
           {:tools (or (get config "tools") (as (List String) []))
            :da-policy (get config "da-policy")})
         (nefor.graph.store-port run-in) [(nefor.graph.store-port run-out)])
       (nefor.graph.actor tool-result-id tool-result-factory []
         (as ToolResultParams {})
         (nefor.graph.store-port result-in)
         [(nefor.graph.store-port result-out)])]
     :routes [(nefor.graph.stored-route entry-out llm-in)
              (nefor.graph.stored-route tool-calls run-in)
              (nefor.graph.stored-route run-out result-in)
              (nefor.graph.stored-route result-out llm-in)]
     :messages []
     :rules []
     :nodes [(nefor.graph.logical-node [id] [])
             (nefor.graph.logical-node [id "entry"] [entry-id])
             (nefor.graph.logical-node [id "llm"] [llm-id])
             (nefor.graph.logical-node [id "run-tool"] [run-tool-id])
             (nefor.graph.logical-node [id "tool-result"] [tool-result-id])]
     :input entry-in
     :output result})))

(let agent (fn [M I O] [[resolve-model (Fn M ResolvedModel)]
                [config (AgentConfig M)] [input-type (TypeTag I)]
                [output-type (TypeTag O)]]
  -> (nefor.graph.Node I (| O nefor.contracts.AgentError))
  (agent-with-schema resolve-model config input-type output-type
    (type-schema output-type) false
    (type-id (type-evidence output-type)) (type-evidence output-type))))

(let dynamic-agent (fn [M I O] [[resolve-model (Fn M ResolvedModel)]
                        [config (AgentConfig M)] [input-type (TypeTag I)]
                        [item-type (TypeTag O)]]
  -> (nefor.graph.Node I
       (| (nefor.dynamic.DynamicList O) nefor.contracts.AgentError))
  (agent-with-schema resolve-model config input-type
    (type-tag (nefor.dynamic.DynamicList O))
    (type-schema (type-tag (List O))) true
    (type-id (type-evidence item-type)) (type-evidence item-type))))

;; Base toolset shorthands for common delegated-agent capability profiles.
;; Explicit custom :tools lists remain the right shape for narrower
;; roles or config-specific tools.
(require "nefor.toolsets")
(let read-only-tools nefor.toolsets.read-only)
(let general-tools nefor.toolsets.general)

(let result-arm (fn [I O T]
  [[fragment (nefor.graph.Node I (| O nefor.contracts.AgentError))]
   [type (TypeTag T)]] -> (nefor.graph.Port T)
  (let result (get fragment "output"))
  (nefor.graph.port (get result "actor") type (get result "wire"))))

(let retry-gate (fn [T] [[config RetryGateConfig] [type (TypeTag T)]]
  -> (nefor.graph.Node T
       (| (nefor.contracts.Continue T) (nefor.contracts.Exhausted T)))
  (let id (get config "id"))
  (let actor-id (str id ".retry-gate"))
  (let result-id (str id ".result"))
  (let input (nefor.graph.port actor-id type "nefor.retry.Input"))
  (let continued (nefor.graph.port actor-id
                    (type-tag (nefor.contracts.Continue T))
                    "nefor.retry.Continue"))
  (let exhausted (nefor.graph.port actor-id
                    (type-tag (nefor.contracts.Exhausted T))
                    "nefor.retry.Exhausted"))
  (let result
    (nefor.graph.identity result-id
      (type-tag
        (| (nefor.contracts.Continue T) (nefor.contracts.Exhausted T)))))
  (nefor.graph.node-with-rules-and-nodes id "ordinary"
    [(nefor.graph.actor actor-id retry-gate-factory
       [(type-evidence type)]
       (as RetryGateParams {:max_retries (get config "max-retries")})
       (nefor.graph.store-port input)
       [(nefor.graph.store-port continued)
        (nefor.graph.store-port exhausted)])
     (first (get result "actors"))]
    [(nefor.graph.stored-route continued (get result "input"))
     (nefor.graph.stored-route exhausted (get result "input"))]
    (as (List nefor.graph.Message) [])
    (as (List nefor.graph.Rule) [])
    [(nefor.graph.logical-node [id] [])
     (nefor.graph.logical-node [id "gate"] [actor-id])
     (nefor.graph.logical-node [id "result"] [result-id])]
    input
    (get result "output"))))

(let approval-gate (fn [[config ApprovalConfig]]
  -> (nefor.graph.Node nefor.contracts.TextAnswer
       (| nefor.contracts.Approved nefor.contracts.Rejected))
  (let id (get config "id"))
  (let actor-id (str id ".human"))
  (let result-id (str id ".result"))
  (let input (nefor.graph.port actor-id
                (type-tag nefor.contracts.TextAnswer)
                "generic-provider.TextAnswer"))
  (let approved (nefor.graph.port actor-id
                   (type-tag nefor.contracts.Approved)
                   "human.Approved"))
  (let rejected (nefor.graph.port actor-id
                   (type-tag nefor.contracts.Rejected)
                   "human.Rejected"))
  (let result
    (nefor.graph.identity result-id
      (type-tag (| nefor.contracts.Approved nefor.contracts.Rejected))))
  (nefor.graph.node-with-rules-and-nodes id "ordinary"
    [(nefor.graph.actor actor-id human-factory []
       (as HumanParams {:prompt (get config "prompt")})
       (nefor.graph.store-port input)
       [(nefor.graph.store-port approved)
        (nefor.graph.store-port rejected)])
     (first (get result "actors"))]
    [(nefor.graph.stored-route approved (get result "input"))
     (nefor.graph.stored-route rejected (get result "input"))]
    (as (List nefor.graph.Message) [])
    (as (List nefor.graph.Rule) [])
    [(nefor.graph.logical-node [id] [])
     (nefor.graph.logical-node [id "human"] [actor-id])
     (nefor.graph.logical-node [id "result"] [result-id])]
    input
    (get result "output"))))
