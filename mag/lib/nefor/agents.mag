import core.types.{}

import core.map.{}

import nefor.actors.{}

import nefor.contracts.{}

import nefor.dynamic.{}

import nefor.graph.{}

import nefor.mag.{}

type AgentInputEnvelope {kind: String, value: Unit}

type DynamicTemplateConfig<M> {model: M, tools: List<String>, tool_approval_policy: nefor.contracts.ToolApprovalPolicy, max_corrections: Int}

// Build the one structural template shape currently required by runtime
// traversal. This is deliberately agent-specific rather than a generic node
// serializer: every dynamic parameter and actor reference is explicit.
let template_port_from_stored: fn(nefor.mag.ActorRef, nefor.graph.StoredPort) -> nefor.mag.TemplatePort = |actor, value| => nefor.mag.TemplatePort {actor: actor, `type`: get(value, "type"), type_id: get(value, "type_id"), wire: get(value, "wire")}

let template_actor: fn(String, nefor.dynamic.ValueRef<String>, nefor.graph.Actor, List<nefor.mag.ScalarParameterBinding>) -> nefor.mag.TemplateActor = |slot, id_ref, value, bindings| => {
  let reference = nefor.dynamic.local_actor_ref(slot)
  nefor.mag.TemplateActor {slot: slot, id: get(id_ref, "id"), factory: get(value, "factory"), type_arguments: get(value, "type_arguments"), params: get(value, "params"), input: template_port_from_stored(reference, get(value, "input")), outputs: map(((|port| => template_port_from_stored(reference, port)) : fn(nefor.graph.StoredPort) -> nefor.mag.TemplatePort), get(value, "outputs")), parameter_bindings: bindings}
}

let actor_with_id: fn(List<nefor.graph.Actor>, String) -> nefor.graph.Actor = |actors, id| => first(filter(((|candidate| => (=)(get(candidate, "id"), id)) : fn(nefor.graph.Actor) -> Bool), actors))

let dynamic_template<M, O>: fn(String, fn(M) -> nefor.actors.AuthoredModel, DynamicTemplateConfig<M>, nefor.dynamic.ValueRef<String>, nefor.dynamic.ValueRef<Int>, nefor.dynamic.ValueRef<String>, nefor.dynamic.ValueRef<String>, nefor.dynamic.ValueRef<String>, TypeTag<O>) -> nefor.dynamic.TemplateNode<Unit, core.types.Result<nefor.contracts.AgentError, O>> = |traversal_id, resolve_model, config, collection_ref, index_ref, worker_id, root_id, system, output_type| => {
  let concrete = nefor.actors.agent("template", resolve_model, nefor.actors.AgentConfig<M> {model: get(config, "model"), system: "", tools: get(config, "tools"), tool_approval_policy: get(config, "tool_approval_policy"), max_corrections: get(config, "max_corrections")}, type_tag<Unit>(), output_type)
  let actors = get(concrete, "actors")
  let entry = actor_with_id(actors, "template.entry")
  let llm = actor_with_id(actors, "template.llm")
  let run_tool = actor_with_id(actors, "template.run-tool")
  let tool_result = actor_with_id(actors, "template.tool-result")
  let suffix = nefor.dynamic.int_to_decimal_string_ref(index_ref)
  let entry_id = nefor.dynamic.concat_strings_ref([worker_id, nefor.dynamic.capture_ref(".entry")])
  let llm_id = nefor.dynamic.concat_strings_ref([worker_id, nefor.dynamic.capture_ref(".llm")])
  let run_tool_id = nefor.dynamic.concat_strings_ref([worker_id, nefor.dynamic.capture_ref(".run-tool")])
  let tool_result_id = nefor.dynamic.concat_strings_ref([worker_id, nefor.dynamic.capture_ref(".tool-result")])
  let result_id = nefor.dynamic.concat_strings_ref([nefor.dynamic.capture_ref(str(traversal_id, ".result.")), suffix])
  let result_input = nefor.dynamic.template_port(nefor.dynamic.local_actor_ref("result"), type_tag<core.types.Result<nefor.contracts.AgentError, O>>(), "nefor.dynamic.IndexInput")
  let result_output = nefor.dynamic.template_port(nefor.dynamic.local_actor_ref("result"), type_tag<nefor.dynamic.DynamicEvent<core.types.Result<nefor.contracts.AgentError, O>>>(), "nefor.dynamic.Event")
  let collect = nefor.dynamic.template_port(nefor.dynamic.existing_actor_ref(str(traversal_id, ".output")), type_tag<nefor.dynamic.DynamicEvent<core.types.Result<nefor.contracts.AgentError, O>>>(), "nefor.dynamic.Collect")
  let result_params = pack(nefor.dynamic.DynamicIndexParams {collection: traversal_id, index: 0})
  let result_actor = nefor.mag.TemplateActor {slot: "result", id: get(result_id, "id"), factory: nefor.dynamic.dynamic_index_factory, type_arguments: [type_evidence(type_tag<core.types.Result<nefor.contracts.AgentError, O>>()), type_evidence(type_tag<nefor.dynamic.DynamicEvent<core.types.Result<nefor.contracts.AgentError, O>>>())], params: result_params, input: result_input, outputs: [result_output], parameter_bindings: [nefor.mag.ScalarParameterBinding {path: ["collection"], value: get(collection_ref, "id")}, nefor.mag.ScalarParameterBinding {path: ["index"], value: get(index_ref, "id")}]}
  let entry_ref = nefor.dynamic.local_actor_ref("entry")
  let llm_ref = nefor.dynamic.local_actor_ref("llm")
  let run_tool_ref = nefor.dynamic.local_actor_ref("run-tool")
  let tool_result_ref = nefor.dynamic.local_actor_ref("tool-result")
  let entry_template = template_actor("entry", entry_id, entry, [])
  let llm_template = template_actor("llm", llm_id, llm, [nefor.mag.ScalarParameterBinding {path: ["system"], value: get(system, "id")}])
  let run_tool_template = template_actor("run-tool", run_tool_id, run_tool, [nefor.mag.ScalarParameterBinding {path: ["conversation_peer"], value: get(llm_id, "id")}])
  let tool_result_template = template_actor("tool-result", tool_result_id, tool_result, [])
  let entry_in = get(entry_template, "input")
  let entry_out = first(get(entry_template, "outputs"))
  let llm_in = get(llm_template, "input")
  let llm_tool_calls = first(get(llm_template, "outputs"))
  let llm_result = first(remove_at(get(llm_template, "outputs"), 0))
  let run_in = get(run_tool_template, "input")
  let run_out = first(get(run_tool_template, "outputs"))
  let tool_result_in = get(tool_result_template, "input")
  let tool_result_out = first(get(tool_result_template, "outputs"))
  let routes = [nefor.mag.TemplateRoute {from: entry_out, to: llm_in, product_position: -1}, nefor.mag.TemplateRoute {from: llm_tool_calls, to: run_in, product_position: -1}, nefor.mag.TemplateRoute {from: run_out, to: tool_result_in, product_position: -1}, nefor.mag.TemplateRoute {from: tool_result_out, to: llm_in, product_position: -1}, nefor.mag.TemplateRoute {from: llm_result, to: result_input, product_position: -1}, nefor.mag.TemplateRoute {from: result_output, to: collect, product_position: -1}]
  let unit_descriptor = type_evidence(type_tag<Unit>())
  let message = nefor.mag.TemplateMessage {to: entry_in, semantic_type: unit_descriptor, semantic_type_id: type_id(unit_descriptor), content: pack(AgentInputEnvelope {kind: "nefor.agent.Input", value: nil})}
  let root_segment = nefor.dynamic.bound_segment(root_id)
  let worker_segment = nefor.dynamic.fixed_segment("worker")
  let result_segment = nefor.dynamic.fixed_segment("result")
  let template = nefor.mag.DeltaTemplate {types: (core.map.empty(type_tag<String>()): Map<String, TypeDescriptor>), actors: [entry_template, llm_template, run_tool_template, tool_result_template, result_actor], routes: routes, messages: [message], nodes: [nefor.mag.TemplateLogicalNode {path: [root_segment], members: ([]: List<nefor.mag.LocalActorRef>)}, nefor.mag.TemplateLogicalNode {path: [root_segment, worker_segment], members: ([]: List<nefor.mag.LocalActorRef>)}, nefor.mag.TemplateLogicalNode {path: [root_segment, worker_segment, nefor.dynamic.fixed_segment("entry")], members: [nefor.mag.LocalActorRef {slot: "entry"}]}, nefor.mag.TemplateLogicalNode {path: [root_segment, worker_segment, nefor.dynamic.fixed_segment("llm")], members: [nefor.mag.LocalActorRef {slot: "llm"}]}, nefor.mag.TemplateLogicalNode {path: [root_segment, worker_segment, nefor.dynamic.fixed_segment("run-tool")], members: [nefor.mag.LocalActorRef {slot: "run-tool"}]}, nefor.mag.TemplateLogicalNode {path: [root_segment, worker_segment, nefor.dynamic.fixed_segment("tool-result")], members: [nefor.mag.LocalActorRef {slot: "tool-result"}]}, nefor.mag.TemplateLogicalNode {path: [root_segment, result_segment], members: [nefor.mag.LocalActorRef {slot: "result"}]}], actor_reference_relocations: ([]: List<nefor.mag.ActorReferenceRelocation>)}
  let captures = nefor.dynamic.merge_captures([get(collection_ref, "captures"), get(index_ref, "captures"), get(worker_id, "captures"), get(root_id, "captures"), get(system, "captures"), get(entry_id, "captures"), get(llm_id, "captures"), get(run_tool_id, "captures"), get(tool_result_id, "captures"), get(result_id, "captures")])
  let expressions = nefor.dynamic.merge_expressions([get(collection_ref, "expressions"), get(index_ref, "expressions"), get(worker_id, "expressions"), get(root_id, "expressions"), get(system, "expressions"), get(entry_id, "expressions"), get(llm_id, "expressions"), get(run_tool_id, "expressions"), get(tool_result_id, "expressions"), get(result_id, "expressions")])
  nefor.dynamic.TemplateNode<Unit, core.types.Result<nefor.contracts.AgentError, O>> {template: template, input: entry_in, output: result_output, root: traversal_id, id_ref: worker_id, captures: captures, expressions: expressions}
}
