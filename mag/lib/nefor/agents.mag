(require "core.types")
(require "core.map")
(require "nefor.actors")
(require "nefor.contracts")
(require "nefor.dynamic")
(require "nefor.graph")
(require "nefor.mag")

;; Reusable agent constructors stay generic over the configuration-owned model
;; vocabulary. A consumer supplies only its typed resolver, selected model, and
;; tools; Nefor owns the graph construction once.
(let with-tools
  (fn [M I O] [[resolve-model (Fn M nefor.actors.AuthoredModel)]
                [model M]
                [id String]
                [system String]
                [tools (List String)]
                [input-type (TypeTag I)]
                [output-type (TypeTag O)]
                [max-corrections Int]]
    -> (nefor.graph.Node I (core.types.Result nefor.contracts.AgentError O))
    (nefor.actors.agent resolve-model
      (as (nefor.actors.AgentConfig M)
        {:id id
         :model model
         :system system
         :tools tools
         :da-policy (nefor.contracts.no-da-policy)
         :max-corrections max-corrections})
      input-type output-type)))

(let with-resolved-tools
  (fn [M I O] [[resolve-model (Fn M nefor.actors.ResolvedModel)]
                [model M]
                [id String]
                [system String]
                [tools (List String)]
                [input-type (TypeTag I)]
                [output-type (TypeTag O)]
                [max-corrections Int]]
    -> (nefor.graph.Node I (core.types.Result nefor.contracts.AgentError O))
    (with-tools
      (fn [[selected M]] -> nefor.actors.AuthoredModel
        (construct nefor.actors.AuthoredModel ResolvedModel (resolve-model selected)))
      model id system tools input-type output-type max-corrections)))

(let dynamic-with-tools
  (fn [M I O] [[resolve-model (Fn M nefor.actors.AuthoredModel)]
                [model M]
                [id String]
                [system String]
                [tools (List String)]
                [input-type (TypeTag I)]
                [item-type (TypeTag O)]
                [max-corrections Int]]
    -> (nefor.graph.Node I
         (core.types.Result nefor.contracts.AgentError (nefor.dynamic.DynamicList O)))
    (nefor.actors.dynamic-agent resolve-model
      (as (nefor.actors.AgentConfig M)
        {:id id
         :model model
         :system system
         :tools tools
         :da-policy (nefor.contracts.no-da-policy)
         :max-corrections max-corrections})
      input-type item-type)))

(let dynamic-with-resolved-tools
  (fn [M I O] [[resolve-model (Fn M nefor.actors.ResolvedModel)]
                [model M]
                [id String]
                [system String]
                [tools (List String)]
                [input-type (TypeTag I)]
                [item-type (TypeTag O)]
                [max-corrections Int]]
    -> (nefor.graph.Node I
         (core.types.Result nefor.contracts.AgentError (nefor.dynamic.DynamicList O)))
    (dynamic-with-tools
      (fn [[selected M]] -> nefor.actors.AuthoredModel
        (construct nefor.actors.AuthoredModel ResolvedModel (resolve-model selected)))
      model id system tools input-type item-type max-corrections)))

;; Build the one structural template shape currently required by runtime
;; traversal. This is deliberately agent-specific rather than a generic node
;; serializer: every dynamic parameter and actor reference is explicit.
(let template-port-from-stored
  (fn [[actor nefor.mag.ActorRef] [value nefor.graph.StoredPort]] -> nefor.mag.TemplatePort
    (as nefor.mag.TemplatePort
      {:actor actor :type (get value "type") :type_id (get value "type_id")
       :wire (get value "wire")})))
(let template-actor
  (fn [[slot String] [id-ref (nefor.dynamic.ValueRef String)]
       [value nefor.graph.Actor]
       [bindings (List nefor.mag.ScalarParameterBinding)]] -> nefor.mag.TemplateActor
    (let reference (nefor.dynamic.local-actor-ref slot))
    (as nefor.mag.TemplateActor
      {:slot slot :id (get id-ref "id") :factory (get value "factory")
       :type_arguments (get value "type_arguments") :params (get value "params")
       :input (template-port-from-stored reference (get value "input"))
       :outputs (map (fn [[port nefor.graph.StoredPort]] -> nefor.mag.TemplatePort
                       (template-port-from-stored reference port))
                  (get value "outputs"))
       :parameter_bindings bindings})))
(let actor-with-id
  (fn [[actors (List nefor.graph.Actor)] [id String]] -> nefor.graph.Actor
    (first (filter (fn [[candidate nefor.graph.Actor]] -> Bool
                     (= (get candidate "id") id)) actors))))
(let dynamic-template-with-tools
  (fn [M O]
    [[resolve-model (Fn M nefor.actors.AuthoredModel)] [model M]
     [traversal-id String]
     [collection-ref (nefor.dynamic.ValueRef String)]
     [index-ref (nefor.dynamic.ValueRef Int)]
     [worker-id (nefor.dynamic.ValueRef String)]
     [root-id (nefor.dynamic.ValueRef String)]
     [system (nefor.dynamic.ValueRef String)]
     [tools (List String)] [output-type (TypeTag O)] [max-corrections Int]]
    -> (nefor.dynamic.TemplateNode Unit (core.types.Result nefor.contracts.AgentError O))
    (let concrete
      (with-tools resolve-model model "template" "" tools
        (type-tag Unit) output-type max-corrections))
    (let actors (get concrete "actors"))
    (let entry (actor-with-id actors "template.entry"))
    (let llm (actor-with-id actors "template.llm"))
    (let run-tool (actor-with-id actors "template.run-tool"))
    (let tool-result (actor-with-id actors "template.tool-result"))
    (let suffix (nefor.dynamic.int-to-decimal-string-ref index-ref))
    (let entry-id (nefor.dynamic.concat-strings-ref
      [worker-id (nefor.dynamic.capture-ref ".entry" (type-tag String))]))
    (let llm-id (nefor.dynamic.concat-strings-ref
      [worker-id (nefor.dynamic.capture-ref ".llm" (type-tag String))]))
    (let run-tool-id (nefor.dynamic.concat-strings-ref
      [worker-id (nefor.dynamic.capture-ref ".run-tool" (type-tag String))]))
    (let tool-result-id (nefor.dynamic.concat-strings-ref
      [worker-id (nefor.dynamic.capture-ref ".tool-result" (type-tag String))]))
    (let result-id (nefor.dynamic.concat-strings-ref
      [(nefor.dynamic.capture-ref (str traversal-id ".result.") (type-tag String)) suffix]))
    (let result-input (nefor.dynamic.template-port
      (nefor.dynamic.local-actor-ref "result")
      (type-tag (core.types.Result nefor.contracts.AgentError O)) "nefor.dynamic.IndexInput"))
    (let result-output (nefor.dynamic.template-port
      (nefor.dynamic.local-actor-ref "result")
      (type-tag (nefor.dynamic.DynamicEvent (core.types.Result nefor.contracts.AgentError O)))
      "nefor.dynamic.Event"))
    (let collect (nefor.dynamic.template-port
      (nefor.dynamic.existing-actor-ref (str traversal-id ".output"))
      (type-tag (nefor.dynamic.DynamicEvent (core.types.Result nefor.contracts.AgentError O)))
      "nefor.dynamic.Collect"))
    (let result-params
      (pack (as nefor.dynamic.DynamicIndexParams
        {:collection traversal-id :index 0})))
    (let result-actor
      (as nefor.mag.TemplateActor
        {:slot "result" :id (get result-id "id")
         :factory nefor.dynamic.dynamic-index-factory
         :type_arguments [(type-evidence (type-tag (core.types.Result nefor.contracts.AgentError O)))
                          (type-evidence (type-tag (nefor.dynamic.DynamicEvent (core.types.Result nefor.contracts.AgentError O))))]
         :params result-params :input result-input :outputs [result-output]
         :parameter_bindings
           [(as nefor.mag.ScalarParameterBinding
              {:path ["collection"] :value (get collection-ref "id")})
            (as nefor.mag.ScalarParameterBinding
              {:path ["index"] :value (get index-ref "id")})]}))
    (let entry-ref (nefor.dynamic.local-actor-ref "entry"))
    (let llm-ref (nefor.dynamic.local-actor-ref "llm"))
    (let run-tool-ref (nefor.dynamic.local-actor-ref "run-tool"))
    (let tool-result-ref (nefor.dynamic.local-actor-ref "tool-result"))
    (let entry-template (template-actor "entry" entry-id entry []))
    (let llm-template (template-actor "llm" llm-id llm
      [(as nefor.mag.ScalarParameterBinding
         {:path ["system"] :value (get system "id")})]))
    (let run-tool-template (template-actor "run-tool" run-tool-id run-tool
      [(as nefor.mag.ScalarParameterBinding
         {:path ["conversation_peer"] :value (get llm-id "id")})]))
    (let tool-result-template (template-actor "tool-result" tool-result-id tool-result []))
    (let entry-in (get entry-template "input"))
    (let entry-out (first (get entry-template "outputs")))
    (let llm-in (get llm-template "input"))
    (let llm-tool-calls (first (get llm-template "outputs")))
    (let llm-result (first (remove-at (get llm-template "outputs") 0)))
    (let run-in (get run-tool-template "input"))
    (let run-out (first (get run-tool-template "outputs")))
    (let tool-result-in (get tool-result-template "input"))
    (let tool-result-out (first (get tool-result-template "outputs")))
    (let routes
      [(as nefor.mag.TemplateRoute {:from entry-out :to llm-in :product_position -1})
       (as nefor.mag.TemplateRoute {:from llm-tool-calls :to run-in :product_position -1})
       (as nefor.mag.TemplateRoute {:from run-out :to tool-result-in :product_position -1})
       (as nefor.mag.TemplateRoute {:from tool-result-out :to llm-in :product_position -1})
       (as nefor.mag.TemplateRoute {:from llm-result :to result-input :product_position -1})
       (as nefor.mag.TemplateRoute {:from result-output :to collect :product_position -1})])
    (let unit-descriptor (type-evidence (type-tag Unit)))
    (let message
      (as nefor.mag.TemplateMessage
        {:to entry-in :semantic_type unit-descriptor
         :semantic_type_id (type-id unit-descriptor)
         :content (pack {:kind "nefor.agent.Input" :value nil})}))
    (let root-segment (nefor.dynamic.bound-segment root-id))
    (let worker-segment (nefor.dynamic.fixed-segment "worker"))
    (let result-segment (nefor.dynamic.fixed-segment "result"))
    (let template
      (as nefor.mag.DeltaTemplate
        {:types (as (Map String TypeDescriptor)
                  (core.map.empty (type-tag String)))
         :actors [entry-template llm-template run-tool-template tool-result-template result-actor]
         :routes routes :messages [message]
         :nodes
           [(as nefor.mag.TemplateLogicalNode
              {:path [root-segment] :members (as (List nefor.mag.LocalActorRef) [])})
            (as nefor.mag.TemplateLogicalNode
              {:path [root-segment worker-segment] :members (as (List nefor.mag.LocalActorRef) [])})
            (as nefor.mag.TemplateLogicalNode
              {:path [root-segment worker-segment (nefor.dynamic.fixed-segment "entry")]
               :members [(as nefor.mag.LocalActorRef {:slot "entry"})]})
            (as nefor.mag.TemplateLogicalNode
              {:path [root-segment worker-segment (nefor.dynamic.fixed-segment "llm")]
               :members [(as nefor.mag.LocalActorRef {:slot "llm"})]})
            (as nefor.mag.TemplateLogicalNode
              {:path [root-segment worker-segment (nefor.dynamic.fixed-segment "run-tool")]
               :members [(as nefor.mag.LocalActorRef {:slot "run-tool"})]})
            (as nefor.mag.TemplateLogicalNode
              {:path [root-segment worker-segment (nefor.dynamic.fixed-segment "tool-result")]
               :members [(as nefor.mag.LocalActorRef {:slot "tool-result"})]})
            (as nefor.mag.TemplateLogicalNode
              {:path [root-segment result-segment]
               :members [(as nefor.mag.LocalActorRef {:slot "result"})]})]
         :actor_reference_relocations (as (List nefor.mag.ActorReferenceRelocation) [])}))
    (let captures (nefor.dynamic.merge-captures
      [(get collection-ref "captures") (get index-ref "captures")
       (get worker-id "captures") (get root-id "captures")
       (get system "captures") (get entry-id "captures") (get llm-id "captures")
       (get run-tool-id "captures") (get tool-result-id "captures")
       (get result-id "captures")]))
    (let expressions (nefor.dynamic.merge-expressions
      [(get collection-ref "expressions") (get index-ref "expressions")
       (get worker-id "expressions")
       (get root-id "expressions") (get system "expressions")
       (get entry-id "expressions") (get llm-id "expressions")
       (get run-tool-id "expressions") (get tool-result-id "expressions")
       (get result-id "expressions")]))
    (as (nefor.dynamic.TemplateNode Unit (core.types.Result nefor.contracts.AgentError O))
      {:template template :input entry-in :output result-output
       :root traversal-id :id_ref worker-id
       :captures captures :expressions expressions})))
