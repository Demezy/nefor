// Shared runtime-facing domain values used across actor families. Factory
// identities and actor parameter records live with their constructors.
import core.map.{}

import core.types.{}

type Task {prompt: String}

type ProviderInput {content: JsonValue}

// Direct-text codec: provider terminal text is the value. Unlike every other
// named contract, this exact nominal type bypasses structured JSON.
newtype TextAnswer = String

type ToolCall {name: String, arguments: JsonValue}

type ToolCalls {calls: List<ToolCall>}

type ToolHandle {results: JsonValue}

type ToolResult {content: String}

type Approved {content: String}

type Rejected {reason: String}

type ApprovalDecision = Approved(Approved) | Rejected(Rejected)

type Text {content: String}

type OutputViolation {path: String, code: String, expected: String, actual: String, message: String}

type OptionalIdentifier {present: Bool, value: String}

type ProviderError {message: String, detail: OptionalIdentifier}

type OutputValidationError {violations: List<OutputViolation>}

type AgentErrorReason = ProviderError(ProviderError) | OutputValidationError(OutputValidationError)

type AgentError {last_output: JsonValue, reason: AgentErrorReason}

type ToolApprovalPolicy {rules: Map<String, String>}

type Timeout {present: Bool, milliseconds: Int}

type ProcessExited {code: Int}

type ProcessSignaled {signal: Int}

type ProcessTermination = ProcessExited(ProcessExited) | ProcessSignaled(ProcessSignaled)

type ProcessResult {stdout: String, stderr: String, termination: ProcessTermination}

type ProcessFailure {operation: String, error: String}

type RetryDecision<T> = Continue(T) | Exhausted(T)

let no_identifier: fn() -> OptionalIdentifier = | | => OptionalIdentifier {present: false, value: ""}

let identifier: fn(String) -> OptionalIdentifier = |value| => OptionalIdentifier {present: true, value: value}

let no_tool_approval_policy: fn() -> ToolApprovalPolicy = | | => ToolApprovalPolicy {rules: (core.map.empty(type_tag<String>()): Map<String, String>)}

let tool_approval_policy: fn(Map<String, String>) -> ToolApprovalPolicy = |rules| => ToolApprovalPolicy {rules: rules}

let no_timeout: fn() -> Timeout = | | => Timeout {present: false, milliseconds: 0}

let timeout_ms: fn(Int) -> Timeout = |milliseconds| => Timeout {present: true, milliseconds: milliseconds}
