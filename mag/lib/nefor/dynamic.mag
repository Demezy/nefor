(require "core.validated")
(require "nefor.contracts")
(require "nefor.graph")

(let collector-factory "nefor.factory.collector")
(let collect-item-factory "nefor.factory.collect-item")
(let collected-prompt-factory "nefor.factory.collected-prompt")
(type CollectorParams {:expected_senders (List String)})
(type DynamicParams {})

;; Runtime-backed typed fan-in. The wire wrapper is private to this library;
;; callers work with semantic T and (List T) ports.
(let collector (fn [T] [[id String]
                         [expected-senders (List String)]
                         [item-type (TypeTag T)]]
  -> (nefor.graph.Node T (List T))
  (let input (nefor.graph.port id item-type "nefor.dynamic.Item"))
  (let output (nefor.graph.port id (type-tag (List T)) "nefor.dynamic.Collected"))
  (as (nefor.graph.Node T (List T))
      {:id id :role "ordinary" :actors [(nefor.graph.actor id collector-factory
                  [(type-evidence item-type)]
                  (as CollectorParams
                    {:expected_senders expected-senders})
                  (nefor.graph.store-port input)
                  [(nefor.graph.store-port output)])]
       :routes (as (List nefor.graph.StoredRoute) [])
       :messages []
       :input input
       :output output})))

;; The zero-worker branch must bypass collector construction. This message
;; activates a static consumer that accepts the collector's output wire.
(let empty-to (fn [T] [[target (nefor.graph.Port (List T))]] -> nefor.graph.Message
  (nefor.graph.typed-message target (as (List T) []))))

(let collect-item (fn [T] [[id String] [type (TypeTag T)] [input-wire String]]
  -> (nefor.graph.Node T T)
  (let input (nefor.graph.port id type input-wire))
  (let output (nefor.graph.port id type "nefor.dynamic.Item"))
  (as (nefor.graph.Node T T)
      {:id id :role "ordinary" :actors [(nefor.graph.actor id collect-item-factory
                  [(type-evidence type)]
                  (as DynamicParams {}) (nefor.graph.store-port input)
                  [(nefor.graph.store-port output)])]
       :routes [] :messages [] :input input :output output})))

(let collected-prompt (fn [T] [[id String] [type (TypeTag T)]]
  -> (nefor.graph.Node (List T) nefor.contracts.ProviderInput)
  (let input (nefor.graph.port id (type-tag (List T)) "nefor.dynamic.Collected"))
  (let output (nefor.graph.port id (type-tag nefor.contracts.ProviderInput) "generic-provider.ProviderOut"))
  (as (nefor.graph.Node (List T) nefor.contracts.ProviderInput)
      {:id id :role "ordinary" :actors [(nefor.graph.actor id collected-prompt-factory
                  [(type-evidence type)]
                  (as DynamicParams {}) (nefor.graph.store-port input)
                  [(nefor.graph.store-port output)])]
       :routes [] :messages [] :input input :output output})))
