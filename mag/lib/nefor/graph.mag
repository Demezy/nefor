(require "core.validated")
(require "nefor.contracts")

;; A graph is an immutable edge set. The list is a deterministic storage
;; detail: graph/add-edges/remove-edges normalize it to set semantics.
(type Port [T] {:actor String :type (TypeTag T) :wire String})
(type StoredPort {:actor String
                  :type TypeDescriptor
                  :type_id SemanticTypeId
                  :wire String})
(type Actor {:id String
             :factory String
             :type_arguments (List TypeDescriptor)
             :params PackedValue
             :input StoredPort
             :outputs (List StoredPort)})
(type StoredRoute {:id String :from StoredPort :to StoredPort})
(type Message {:to StoredPort
               :semantic_type TypeDescriptor
               :semantic_type_id SemanticTypeId
               :content PackedValue})
(type Rule {:id String :on StoredPort :fn String})
(type StoredNode {:id String
                  :role String
                  :actors (List Actor)
                  :routes (List StoredRoute)
                  :messages (List Message)
                  :rules (List Rule)
                  :input StoredPort
                  :output StoredPort})
(type Node [I O] {:id String
                  :role String
                  :actors (List Actor)
                  :routes (List StoredRoute)
                  :messages (List Message)
                  :rules (List Rule)
                  :input (Port I)
                  :output (Port O)})
(type Edge {:from StoredNode :to StoredNode :route StoredRoute})
(type Graph {:edges (List Edge)})

;; Runtime subscriptions remain program metadata. They observe a graph but are
;; not vertices or edges and therefore do not participate in edge-set algebra.
(type Program {:graph Graph :rules (List Rule)})

(type FactoryTypeScheme {:input_tags (List String)
                         :outputs (List String)})
(type FactoryContract {:identity String
                       :type_scheme FactoryTypeScheme})
(type SourceParams [T] {:value T :value_type SemanticTypeId})
(type OutputParams {})
(type LowerDestination {:actor String
                        :wire String
                        :edge_id String
                        :source_type_id SemanticTypeId
                        :destination_type_id SemanticTypeId
                        :product_position Int})
(type AssignedRoute {:route StoredRoute :product_position Int})
(type LowerActor {:id String
                  :factory String
                  :type_arguments (List TypeDescriptor)
                  :input StoredPort
                  :outputs (List StoredPort)
                  :params PackedValue
                  :routes (Map String (List LowerDestination))})
(type LowerMessage {:to String
                    :semantic_type TypeDescriptor
                    :semantic_type_id SemanticTypeId
                    :content PackedValue})
(type LowerRule {:id String :on StoredPort :fn String})
(type ResultBoundary {:from StoredPort})
(type Modification {:actors (List LowerActor)
                    :messages (List LowerMessage)
                    :kills (List String)
                    :rules (List LowerRule)
                    :types (Map String TypeDescriptor)
                    :result ResultBoundary})

;; Dynamic rule artifacts remain an operation format over the running actor
;; kernel. They are deliberately not Graph values and are not exposed as graph
;; mutation. Authored graph changes are code changes to a pure Graph -> Graph
;; transformation and execute as a fresh run.
(type Delta {:actors (List Actor)
             :routes (List StoredRoute)
             :messages (List Message)
             :kills (List String)})
(type LowerDelta {:actors (List LowerActor)
                  :messages (List LowerMessage)
                  :kills (List String)
                  :rules (List LowerRule)
                  :types (Map String TypeDescriptor)})

(let port (fn [T] [[actor String] [semantic-type (TypeTag T)] [wire-type String]] -> (Port T)
  (as (Port T) {:actor actor :type semantic-type :wire wire-type})))

(let store-port (fn [T] [[value (Port T)]] -> StoredPort
  (let descriptor (type-evidence (get value "type")))
  (as StoredPort {:actor (get value "actor")
                    :type descriptor
                    :type_id (type-id descriptor)
                    :wire (get value "wire")})))

(let actor (fn [P] [[id String] [factory String]
                [type-arguments (List TypeDescriptor)] [params P]
                [input StoredPort] [outputs (List StoredPort)]] -> Actor
  (as Actor {:id id :factory factory
             :type_arguments type-arguments
             :params (pack params) :input input :outputs outputs})))

(let node (fn [I O] [[id String] [role String] [actors (List Actor)]
                     [routes (List StoredRoute)] [messages (List Message)]
                     [input (Port I)] [output (Port O)]] -> (Node I O)
  (as (Node I O) {:id id :role role :actors actors :routes routes
                  :messages messages :rules [] :input input :output output})))

(let node-with-rules
  (fn [I O] [[id String] [role String] [actors (List Actor)]
             [routes (List StoredRoute)] [messages (List Message)]
             [rules (List Rule)] [input (Port I)] [output (Port O)]]
    -> (Node I O)
    (as (Node I O) {:id id :role role :actors actors :routes routes
                    :messages messages :rules rules
                    :input input :output output})))

(let with-rule
  (fn [I O] [[value (Node I O)] [subscription Rule]] -> (Node I O)
    (node-with-rules
      (get value "id") (get value "role")
      (get value "actors") (get value "routes") (get value "messages")
      (concat (get value "rules") [subscription])
      (get value "input") (get value "output"))))

(let store-node (fn [I O] [[value (Node I O)]] -> StoredNode
  (as StoredNode {:id (get value "id") :role (get value "role")
                  :actors (get value "actors") :routes (get value "routes")
                  :messages (get value "messages")
                  :rules (get value "rules")
                  :input (store-port (get value "input"))
                  :output (store-port (get value "output"))})))

(let stored-route (fn [A B] [[from (Port A)] [to (Port B)]] -> StoredRoute
  (let stored-from (store-port from))
  (let stored-to (store-port to))
  (as StoredRoute
      {:id (canonical {:from stored-from :to stored-to})
       :from stored-from
       :to stored-to})))

(let edge (fn [I T U O] [[from (Node I T)] [to (Node U O)]] -> Edge
  (as Edge {:from (store-node from) :to (store-node to)
            :route (stored-route (get from "output") (get to "input"))})))

(let stored-message (fn [P] [[to StoredPort] [content P]] -> Message
  (as Message {:to to
               :semantic_type (get to "type")
               :semantic_type_id (get to "type_id")
               :content (pack content)})))
(let message (fn [T P] [[to (Port T)] [content P]] -> Message
  (stored-message (store-port to) content)))
(let typed-message (fn [T] [[to (Port T)] [value T]] -> Message
  (let stored (store-port to))
  (let selected (value-type-evidence value (get stored "type")))
  (as Message {:to stored
                 :semantic_type selected
                 :semantic_type_id (type-id selected)
                 :content (pack {:kind (get to "wire") :value value})})))
(let rule (fn [T] [[id String] [on (Port T)] [fn-name String]] -> Rule
  (as Rule {:id id :on (store-port on) :fn fn-name})))

(let source-factory "nefor.factory.source")
(let source (fn [T] [[id String] [type (TypeTag T)] [value T]] -> (Node Unit T)
  (let input (port id (type-tag Unit) "mag.Unit"))
  (let output (port id type "nefor.graph.Value"))
  (let source-actor (actor id source-factory [(type-evidence type)]
                       (as (SourceParams T)
                         {:value value :value_type (value-type-id value type)})
                       (store-port input) [(store-port output)]))
  (node id "source" [source-actor] (as (List StoredRoute) [])
      [(message input {:kind "mag.Unit"})] input output)))

(let output-factory "nefor.factory.output")
(let output (fn [T] [[id String] [type (TypeTag T)]] -> (Node T T)
  (let input (port id type "nefor.graph.Value"))
  (let result (port id type "nefor.graph.Value"))
  (let output-actor (actor id output-factory [(type-evidence type)]
                       (as OutputParams {})
                       (store-port input) [(store-port result)]))
  (node id "output" [output-actor]
      (as (List StoredRoute) []) (as (List Message) []) input result)))

;; An ordinary identity node is the boundary adapter used by hierarchical
;; node combinators. The runtime factory already forwards one typed value; the
;; distinct role keeps this reusable internal node out of the graph's terminal
;; output semantics.
(let identity (fn [T] [[id String] [type (TypeTag T)]] -> (Node T T)
  (let input (port id type "nefor.graph.Value"))
  (let result (port id type "nefor.graph.Value"))
  (let identity-actor (actor id output-factory [(type-evidence type)]
                         (as OutputParams {})
                         (store-port input) [(store-port result)]))
  (node id "ordinary" [identity-actor]
      (as (List StoredRoute) []) (as (List Message) []) input result)))

(let output-for (fn [I T] [[id String] [from (Node I T)]] -> (Node T T)
  (output id (get (get from "output") "type"))))

(let same-edge? (fn [[left Edge] [right Edge]] -> Bool
  (if (= (get (get left "from") "id") (get (get right "from") "id"))
    (if (= (get (get left "to") "id") (get (get right "to") "id"))
      (= (get left "route") (get right "route")) false)
    false)))
(let edge-key (fn [[value Edge]] -> String
  (canonical {:from-node (get (get value "from") "id")
              :to-node (get (get value "to") "id")
              :route (get value "route")})))
(let edge-in? (fn [[edges (List Edge)] [candidate Edge]] -> Bool
  (not (= (count (filter (fn [[value Edge]] -> Bool
                           (same-edge? value candidate)) edges)) 0))))
(let same-edge-definition? (fn [[left Edge] [right Edge]] -> Bool
  (= left right)))
(let insert-edge (fn [[edges (List Edge)] [candidate Edge]] -> (List Edge)
  ;; Equal logical edges are set-idempotent. A duplicate logical edge whose
  ;; embedded node definition differs is retained long enough for validate to
  ;; reject the conflicting node identity; silently dropping it would hide an
  ;; invalid graph behind normalization.
  (if (edge-in? edges candidate)
    (if (not (= (count (filter (fn [[value Edge]] -> Bool
                                  (same-edge-definition? value candidate))
                                edges)) 0))
      edges
      (concat edges [candidate]))
    (concat edges [candidate]))))
(let normalize-edges (fn [[edges (List Edge)]] -> (List Edge)
  (sort-by edge-key (fold insert-edge (as (List Edge) []) edges))))

(let empty-graph (as Graph {:edges (as (List Edge) [])}))
(let graph (fn [[edges (List Edge)]] -> Graph
  (as Graph {:edges (normalize-edges edges)})))
(let add-edges (fn [[value Graph] [added (List Edge)]] -> Graph
  (graph (concat (get value "edges") added))))
(let remove-edges (fn [[value Graph] [removed (List Edge)]] -> Graph
  (graph (filter (fn [[candidate Edge]] -> Bool
                   (not (edge-in? removed candidate)))
                 (get value "edges")))))
(let graph-rules (fn [[value Graph]] -> (List Rule)
  (flat-map (fn [[candidate StoredNode]] -> (List Rule)
              (get candidate "rules"))
            (graph-nodes value))))
(let program (fn [[value Graph] [rules (List Rule)]] -> Program
  (as Program {:graph value :rules (concat (graph-rules value) rules)})))

(let nodes-from-edge (fn [[value Edge]] -> (List StoredNode)
  [(get value "from") (get value "to")]))
(let all-nodes (fn [[value Graph]] -> (List StoredNode)
  (flat-map nodes-from-edge (get value "edges"))))
(let same-node-id? (fn [[left StoredNode] [right StoredNode]] -> Bool
  (= (get left "id") (get right "id"))))
(let node-in? (fn [[nodes (List StoredNode)] [candidate StoredNode]] -> Bool
  (not (= (count (filter (fn [[value StoredNode]] -> Bool
                           (same-node-id? value candidate)) nodes)) 0))))
(let insert-node (fn [[nodes (List StoredNode)] [candidate StoredNode]] -> (List StoredNode)
  (if (node-in? nodes candidate) nodes (concat nodes [candidate]))))
(let graph-nodes (fn [[value Graph]] -> (List StoredNode)
  (fold insert-node (as (List StoredNode) []) (all-nodes value))))

(let conflicting-node? (fn [[nodes (List StoredNode)] [candidate StoredNode]] -> Bool
  (not (= (count
    (filter (fn [[value StoredNode]] -> Bool
      (if (same-node-id? value candidate) (not (= value candidate)) false)) nodes)) 0))))
(let has-node-conflicts? (fn [[value Graph]] -> Bool
  (not (= (count (filter (fn [[candidate StoredNode]] -> Bool
                           (conflicting-node? (all-nodes value) candidate))
                         (all-nodes value))) 0))))

(let external-routes (fn [[value Graph]] -> (List StoredRoute)
  (map (fn [[candidate Edge]] -> StoredRoute (get candidate "route"))
       (get value "edges"))))
(let graph-routes (fn [[value Graph]] -> (List StoredRoute)
  (concat (flat-map (fn [[candidate StoredNode]] -> (List StoredRoute)
                      (get candidate "routes"))
                    (graph-nodes value))
          (external-routes value))))
(let graph-actors (fn [[value Graph]] -> (List Actor)
  (flat-map (fn [[candidate StoredNode]] -> (List Actor)
              (get candidate "actors"))
            (graph-nodes value))))
(let graph-messages (fn [[value Graph]] -> (List Message)
  (flat-map (fn [[candidate StoredNode]] -> (List Message)
              (get candidate "messages"))
            (graph-nodes value))))

(let incoming-count (fn [[value Graph] [id String]] -> Int
  (count (filter (fn [[candidate Edge]] -> Bool
                   (= (get (get candidate "to") "id") id))
                 (get value "edges")))))
(let outgoing-count (fn [[value Graph] [id String]] -> Int
  (count (filter (fn [[candidate Edge]] -> Bool
                   (= (get (get candidate "from") "id") id))
                 (get value "edges")))))
(let role? (fn [[candidate StoredNode] [role String]] -> Bool
  (= (get candidate "role") role)))
(let sources (fn [[value Graph]] -> (List StoredNode)
  (filter (fn [[candidate StoredNode]] -> Bool (role? candidate "source"))
          (graph-nodes value))))
(let outputs (fn [[value Graph]] -> (List StoredNode)
  (filter (fn [[candidate StoredNode]] -> Bool (role? candidate "output"))
          (graph-nodes value))))
(let source-shape-valid? (fn [[value Graph] [candidate StoredNode]] -> Bool
  (if (= (incoming-count value (get candidate "id")) 0)
    (role? candidate "source")
    (not (role? candidate "source")))))
(let output-shape-valid? (fn [[value Graph] [candidate StoredNode]] -> Bool
  (if (role? candidate "output")
    (if (not (= (incoming-count value (get candidate "id")) 0))
      (= (outgoing-count value (get candidate "id")) 0)
      false)
    true)))

(let next-node-ids (fn [[value Graph] [id String]] -> (List String)
  (map (fn [[candidate Edge]] -> String (get (get candidate "to") "id"))
    (filter (fn [[candidate Edge]] -> Bool
              (= (get (get candidate "from") "id") id))
            (get value "edges")))))
(let path-to? (fn [[value Graph] [id String] [target String]
                    [visited (List String)]] -> Bool
  (if (= id target)
    true
    (if (not (= (count (filter (fn [[seen String]] -> Bool (= seen id)) visited)) 0))
      false
      (not (= (count
        (filter (fn [[next String]] -> Bool
                  (path-to? value next target (concat visited [id])))
                (next-node-ids value id))) 0))))))
(let reachable-from-source? (fn [[value Graph] [candidate StoredNode]] -> Bool
  (not (= (count
    (filter (fn [[start StoredNode]] -> Bool
              (path-to? value (get start "id") (get candidate "id")
                        (as (List String) [])))
            (sources value))) 0))))
(let reaches-output? (fn [[value Graph] [candidate StoredNode]] -> Bool
  (let result (first (outputs value)))
  (path-to? value (get candidate "id") (get result "id")
              (as (List String) []))))

(let factory-contract
  (fn [[entry {:identity String
               :type_scheme {:input_tags (List String)
                             :outputs (List String)}}]]
      -> FactoryContract
    (as FactoryContract
      {:identity (get entry "identity")
       :type_scheme (as FactoryTypeScheme
                      {:input_tags (get (get entry "type_scheme") "input_tags")
                       :outputs (get (get entry "type_scheme") "outputs")})})))

(let contains-string? (fn [[values (List String)] [value String]] -> Bool
  (not (= (count (filter (fn [[candidate String]] -> Bool (= candidate value)) values)) 0))))
(let all-strings-in? (fn [[left (List String)] [right (List String)]] -> Bool
  (= (count (filter (fn [[value String]] -> Bool
                      (not (contains-string? right value))) left)) 0)))
(let one-port? (fn [[ports (List StoredPort)] [expected StoredPort]] -> Bool
  (= ports [expected])))
(let empty-packed-map? (fn [[value PackedValue]] -> Bool
  (packed-empty-record? value)))
(let source-params-valid? (fn [[value PackedValue]] -> Bool
  (packed-record-has-only-keys? value ["value" "value_type"])))
(let source-value-valid? (fn [[value Actor] [output StoredPort]] -> Bool
  (packed-field-conforms? (get value "params") "value"
                          (get output "type"))))
(let one-type-argument? (fn [[value Actor] [expected TypeDescriptor]] -> Bool
  (= (get value "type_arguments") [expected])))
(let concrete-source? (fn [[candidate StoredNode]] -> Bool
  (let id (get candidate "id"))
  (let actors (get candidate "actors"))
  (let input (get candidate "input"))
  (let output (get candidate "output"))
  (if (= (count actors) 1)
      ((fn [] -> Bool
        (let boundary (first actors))
        (if (= (get boundary "id") id)
          (if (= (get boundary "factory") source-factory)
            (if (= input (as StoredPort
                    {:actor id
                     :type (type-evidence (type-tag Unit))
                     :type_id (type-id (type-evidence (type-tag Unit)))
                     :wire "mag.Unit"}))
              (if (= (get output "actor") id)
                (if (= (get output "wire") "nefor.graph.Value")
                  (if (= (get boundary "input") input)
                    (if (one-type-argument? boundary (get output "type"))
                      (if (one-port? (get boundary "outputs") output)
                        (if (= (count (get candidate "routes")) 0)
                          (if (= (get candidate "messages")
                                 [(stored-message input {:kind "mag.Unit"})])
                            (if (source-params-valid? (get boundary "params"))
                              (source-value-valid? boundary output) false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)))
      false)))
(let composite-source? (fn [[candidate StoredNode]] -> Bool
  (let input (get candidate "input"))
  (let matching
    (filter (fn [[actor Actor]] -> Bool
              (if (= (get actor "factory") source-factory)
                (= (get actor "input") input)
                false))
            (get candidate "actors")))
  (if (= (count matching) 1)
    ((fn [] -> Bool
      (let boundary (first matching))
      (let outputs (get boundary "outputs"))
      (if (= (count outputs) 1)
        ((fn [] -> Bool
          (let source-output (first outputs))
          (if (one-type-argument? boundary (get source-output "type"))
            (if (= (get candidate "messages")
                   [(stored-message input {:kind "mag.Unit"})])
              (if (source-params-valid? (get boundary "params"))
                (source-value-valid? boundary source-output)
                false)
              false)
            false)))
        false)))
    false)))
(let concrete-output? (fn [[candidate StoredNode]] -> Bool
  (let id (get candidate "id"))
  (let actors (get candidate "actors"))
  (let input (get candidate "input"))
  (let output (get candidate "output"))
  (if (= (count actors) 1)
      ((fn [] -> Bool
        (let boundary (first actors))
        (if (= (get boundary "id") id)
          (if (= (get boundary "factory") output-factory)
            (if (= (get input "actor") id)
              (if (= (get output "actor") id)
                (if (= (get input "wire") "nefor.graph.Value")
                  (if (= (get output "wire") "nefor.graph.Value")
                    (if (= (get input "type") (get output "type"))
                      (if (= (get boundary "input") input)
                        (if (one-type-argument? boundary (get input "type"))
                          (if (one-port? (get boundary "outputs") output)
                            (if (empty-packed-map? (get boundary "params"))
                              (if (= (count (get candidate "routes")) 0)
                                (= (count (get candidate "messages")) 0) false)
                              false)
                            false)
                          false)
                        false)
                      false)
                    false)
                  false)
                false)
              false)
            false)
          false)))
      false)))
(let boundary-valid? (fn [[candidate StoredNode]] -> Bool
  (if (role? candidate "source")
    (if (concrete-source? candidate) true (composite-source? candidate))
    (if (role? candidate "output")
      (concrete-output? candidate)
      (if (role? candidate "ordinary")
        (= (count (get candidate "messages")) 0)
        false)))))
(let actor-output-wires (fn [[value Actor]] -> (List String)
  (map (fn [[output StoredPort]] -> String (get output "wire"))
       (get value "outputs"))))
(let actor-contract-errors (fn [[contracts (List FactoryContract)] [value Actor]]
  -> (List String)
  (let identity (get value "factory"))
  (let matching (filter (fn [[contract FactoryContract]] -> Bool
                           (= (get contract "identity") identity))
                         contracts))
  (if (= (count matching) 0)
      [(str (str (str "actor " (canonical (get value "id")))
                 ": factory identity ")
            (str (canonical identity) " is not present in the runtime inventory"))]
      ((fn [] -> (List String)
      (let scheme (get (first matching) "type_scheme"))
      (let input-wire (get (get value "input") "wire"))
      (let accepted-inputs (get scheme "input_tags"))
      (let output-wires (actor-output-wires value))
      (let accepted-outputs (get scheme "outputs"))
      (let input-errors (if (contains-string? accepted-inputs input-wire)
                (as (List String) [])
                [(str
                   (str (str (str (str "actor " (canonical (get value "id")))
                                      ": factory ")
                                 (canonical identity))
                            (str " rejects input wire " (canonical input-wire)))
                   (str "; accepted input wires: " (canonical accepted-inputs)))]))
      (let output-errors (if (all-strings-in? output-wires accepted-outputs)
                (as (List String) [])
                [(str
                   (str (str (str (str "actor " (canonical (get value "id")))
                                      ": factory ")
                                 (canonical identity))
                            (str " exposes output wires " (canonical output-wires)))
                   (str "; accepted output wires: " (canonical accepted-outputs)))]))
      (concat input-errors output-errors))))))

(let actor-id-count (fn [[actors (List Actor)] [id String]] -> Int
  (count (filter (fn [[candidate Actor]] -> Bool (= (get candidate "id") id)) actors))))
(let actor-ids-valid? (fn [[value Graph]] -> Bool
  (= (count (filter (fn [[candidate Actor]] -> Bool
                      (not (= (actor-id-count (graph-actors value)
                                              (get candidate "id")) 1)))
                    (graph-actors value))) 0)))
(let actor-by-id-exists? (fn [[actors (List Actor)] [id String]] -> Bool
  (= (actor-id-count actors id) 1)))
(let same-port-address? (fn [[left StoredPort] [right StoredPort]] -> Bool
  (if (= (get left "actor") (get right "actor"))
    (= (get left "wire") (get right "wire"))
    false)))
(let port-is-output? (fn [[actors (List Actor)] [value StoredPort]] -> Bool
  (= (count (flat-map (fn [[candidate Actor]] -> (List StoredPort)
    (filter (fn [[output StoredPort]] -> Bool
              (if (same-port-address? output value)
                (descriptor-accepts? (get output "type") (get value "type"))
                false))
            (get candidate "outputs"))) actors)) 1)))
(let port-is-input? (fn [[actors (List Actor)] [value StoredPort]] -> Bool
  (= (count (filter (fn [[candidate Actor]] -> Bool
    (if (= (get candidate "id") (get value "actor"))
      (= (get candidate "input") value) false)) actors)) 1)))
(let route-id (fn [[value StoredRoute]] -> String (get value "id")))
(let incoming-routes-to (fn [[routes (List StoredRoute)] [input StoredPort]]
  -> (List StoredRoute)
  (sort-by route-id
    (filter (fn [[candidate StoredRoute]] -> Bool
              (= (get candidate "to") input))
            routes))))
(let messages-to (fn [[messages (List Message)] [input StoredPort]] -> (List Message)
  (filter (fn [[candidate Message]] -> Bool
            (= (get candidate "to") input))
          messages)))
(let actor-input-source-types (fn [[value Graph] [candidate Actor]]
  -> (List TypeDescriptor)
  (let input (get candidate "input"))
  (concat
      (map (fn [[route StoredRoute]] -> TypeDescriptor
             (get (get route "from") "type"))
           (incoming-routes-to (graph-routes value) input))
      (map (fn [[message Message]] -> TypeDescriptor
             (get (get message "to") "type"))
           (messages-to (graph-messages value) input)))))
(let actor-input-coverage-valid? (fn [[value Graph] [candidate Actor]] -> Bool
  (descriptor-input-covered-by?
    (get (get candidate "input") "type")
    (actor-input-source-types value candidate))))
(let route-handler-types (fn [[routes (List StoredRoute)] [output StoredPort]]
  -> (List TypeDescriptor)
  (map (fn [[route StoredRoute]] -> TypeDescriptor
         (get (get route "to") "type"))
       (filter (fn [[candidate StoredRoute]] -> Bool
                 (same-port-address? (get candidate "from") output))
               routes))))
(let rule-handler-types (fn [[rules (List Rule)] [output StoredPort]]
  -> (List TypeDescriptor)
  (map (fn [[candidate Rule]] -> TypeDescriptor
         (get (get candidate "on") "type"))
       (filter (fn [[candidate Rule]] -> Bool
                 (let handler (get candidate "on"))
                 (if (= (get handler "actor") (get output "actor"))
                     (= (get handler "wire") (get output "wire"))
                     false))
               rules))))
(let terminal-output? (fn [[value Graph] [output StoredPort]] -> Bool
  (not (= (count
    (filter (fn [[candidate StoredNode]] -> Bool
              (if (= (get candidate "role") "output")
                (= (get candidate "output") output)
                false))
            (graph-nodes value))) 0))))
(let actor-output-coverage-valid? (fn [[value Graph] [rules (List Rule)]
                                         [output StoredPort]] -> Bool
  (if (terminal-output? value output)
    true
    (descriptor-output-covered-by?
      (get output "type")
      (concat (route-handler-types (graph-routes value) output)
              (rule-handler-types rules output))))))
(let actor-outputs-coverage-valid? (fn [[value Graph] [rules (List Rule)]
                                          [candidate Actor]] -> Bool
  (= (count
       (filter (fn [[output StoredPort]] -> Bool
                 (not (actor-output-coverage-valid? value rules output)))
               (get candidate "outputs")))
     0)))
(let route-valid? (fn [[actors (List Actor)] [value StoredRoute]] -> Bool
  (if (port-is-output? actors (get value "from"))
    (if (port-is-input? actors (get value "to"))
      (descriptor-accepts? (get (get value "to") "type")
                           (get (get value "from") "type"))
      false)
    false)))

(let validate-with-rules (fn [[value Graph] [rules (List Rule)]
                              [contracts (List FactoryContract)]]
  -> (core.validated.Validated String Graph)
  (let all-rules (concat (graph-rules value) rules))
  (let nodes (graph-nodes value))
    (let actors (graph-actors value))
    (let bad-shapes (filter (fn [[candidate StoredNode]] -> Bool
                       (not (if (source-shape-valid? value candidate)
                              (output-shape-valid? value candidate) false))) nodes))
    (let unreachable (filter (fn [[candidate StoredNode]] -> Bool
                        (not (reachable-from-source? value candidate))) nodes))
    (let dead (if (= (count (outputs value)) 1)
                 (filter (fn [[candidate StoredNode]] -> Bool
                           (not (reaches-output? value candidate))) nodes)
                 nodes))
    (let contract-errors (flat-map
                            (fn [[candidate Actor]] -> (List String)
                              (actor-contract-errors contracts candidate))
                            actors))
    (let bad-boundaries (filter (fn [[candidate StoredNode]] -> Bool
                            (not (boundary-valid? candidate))) nodes))
    (let bad-input-coverage (filter (fn [[candidate Actor]] -> Bool
                                (not (actor-input-coverage-valid? value candidate))) actors))
    (let bad-output-coverage (filter (fn [[candidate Actor]] -> Bool
                                 (not (actor-outputs-coverage-valid? value all-rules candidate))) actors))
    (let bad-routes (filter (fn [[candidate StoredRoute]] -> Bool
                        (not (route-valid? actors candidate))) (graph-routes value)))
    (as (core.validated.Validated String Graph)
    (if (= (count (get value "edges")) 0)
        (core.validated.invalid ["graph needs at least one edge"])
        (if (has-node-conflicts? value)
          (core.validated.invalid ["one node id must denote one immutable node definition"])
          (if (not (actor-ids-valid? value))
            (core.validated.invalid ["runtime actor ids must be unique across graph nodes"])
            (if (not (= (count (outputs value)) 1))
              (core.validated.invalid ["graph needs exactly one concrete output node"])
              (if (= (count bad-shapes) 0)
                (if (= (count bad-boundaries) 0)
                  (if (= (count bad-input-coverage) 0)
                    (if (= (count bad-output-coverage) 0)
                      (if (= (count unreachable) 0)
                        (if (= (count dead) 0)
                          (if (= (count contract-errors) 0)
                            (if (= (count bad-routes) 0)
                              (core.validated.valid value)
                              (core.validated.invalid ["graph contains an unknown or incompatible edge"]))
                            (core.validated.invalid contract-errors))
                          (core.validated.invalid ["every node must have a path to the output node"]))
                        (core.validated.invalid ["every node must be reachable from a source node"]))
                      (core.validated.invalid ["every actor output alternative must have an ordinary route, resident subscription, or terminal output path"]))
                    (core.validated.invalid ["actor input incoming types must be compatible and exactly cover every product occurrence"]))
                  (core.validated.invalid ["boundary node roles require their concrete source/output factory shape, and ordinary nodes cannot contain initial messages"]))
                (core.validated.invalid ["only source nodes may have zero incoming edges, and output nodes are terminal"])))))))))

(let validate (fn [[value Graph] [contracts (List FactoryContract)]]
  -> (core.validated.Validated String Graph)
  (validate-with-rules value (as (List Rule) []) contracts)))

(let zip-route-assignments (fn [[routes (List StoredRoute)] [positions (List Int)]]
  -> (List AssignedRoute)
  (if (= (count routes) 0)
    (as (List AssignedRoute) [])
    (concat
      [(as AssignedRoute {:route (first routes)
                          :product_position (first positions)})]
      (zip-route-assignments (remove-at routes 0) (remove-at positions 0))))))
(let assigned-routes-to (fn [[routes (List StoredRoute)] [input StoredPort]]
  -> (List AssignedRoute)
  (let incoming (incoming-routes-to routes input))
  (let sources (map (fn [[candidate StoredRoute]] -> TypeDescriptor
                       (get (get candidate "from") "type"))
                     incoming))
  (if (= (count incoming) 0)
      (as (List AssignedRoute) [])
      ((fn [] -> (List AssignedRoute)
        (let positions (descriptor-input-assignments (get input "type") sources))
        (zip-route-assignments incoming positions))))))
(let assigned-route (fn [[routes (List StoredRoute)] [candidate StoredRoute]]
  -> AssignedRoute
  (first
    (filter (fn [[assigned AssignedRoute]] -> Bool
              (= (get (get assigned "route") "id") (get candidate "id")))
            (assigned-routes-to routes (get candidate "to"))))))
(let assigned-routes (fn [[routes (List StoredRoute)]]
  -> (List AssignedRoute)
  (map (fn [[candidate StoredRoute]] -> AssignedRoute
         (assigned-route routes candidate))
       routes)))
(let assigned-routes-from (fn [[routes (List AssignedRoute)] [actor-id String]]
  -> (List AssignedRoute)
  (filter (fn [[candidate AssignedRoute]] -> Bool
            (= (get (get (get candidate "route") "from") "actor") actor-id))
          routes)))
(let actor-routes (fn [[routes (List AssignedRoute)] [value Actor]]
  -> (Map String (List LowerDestination))
  (fold (fn [[out (Map String (List LowerDestination))] [assigned AssignedRoute]]
    -> (Map String (List LowerDestination))
    (let candidate (get assigned "route"))
    (let from (get candidate "from"))
    (let to (get candidate "to"))
    (let wire (get from "wire"))
    (let old (or (get out wire) (as (List LowerDestination) [])))
    (let destination (as LowerDestination {:actor (get to "actor")
                                             :wire (get to "wire")
                                             :edge_id (get candidate "id")
                                             :source_type_id (get from "type_id")
                                             :destination_type_id (get to "type_id")
                                             :product_position (get assigned "product_position")}))
    (assoc out wire (concat old [destination])))
    (as (Map String (List LowerDestination)) {})
    (assigned-routes-from routes (get value "id")))))
(let lower-actor-with-routes (fn [[routes (List AssignedRoute)] [value Actor]] -> LowerActor
  (as LowerActor {:id (get value "id") :factory (get value "factory")
                  :type_arguments (get value "type_arguments") :input (get value "input")
                  :outputs (get value "outputs") :params (get value "params")
                  :routes (actor-routes routes value)})))
(let lower-message (fn [[value Message]] -> LowerMessage
  (let to (get value "to"))
  (as LowerMessage {:to (get to "actor")
                      :semantic_type (get value "semantic_type")
                      :semantic_type_id (get value "semantic_type_id")
                      :content (get value "content")})))
(let lower-rule (fn [[value Rule]] -> LowerRule
  (as LowerRule {:id (get value "id") :on (get value "on") :fn (get value "fn")})))
(let result-boundary (fn [[value Graph]] -> ResultBoundary
  (as ResultBoundary {:from (get (first (outputs value)) "output")})))
(let actor-descriptors (fn [[actors (List Actor)]] -> (List TypeDescriptor)
  (flat-map (fn [[candidate Actor]] -> (List TypeDescriptor)
              (concat [(get (get candidate "input") "type")]
                      (map (fn [[output StoredPort]] -> TypeDescriptor
                             (get output "type"))
                           (get candidate "outputs"))))
            actors)))
(let route-descriptors (fn [[routes (List StoredRoute)]] -> (List TypeDescriptor)
  (flat-map (fn [[candidate StoredRoute]] -> (List TypeDescriptor)
              [(get (get candidate "from") "type")
               (get (get candidate "to") "type")])
            routes)))
(let message-descriptors (fn [[messages (List Message)]] -> (List TypeDescriptor)
  (map (fn [[candidate Message]] -> TypeDescriptor
         (get candidate "semantic_type"))
       messages)))
(let rule-descriptors (fn [[rules (List Rule)]] -> (List TypeDescriptor)
  (map (fn [[candidate Rule]] -> TypeDescriptor
         (get (get candidate "on") "type"))
       rules)))
(let program-descriptors (fn [[topology Graph] [rules (List Rule)]]
  -> (List TypeDescriptor)
  (concat
    (concat
      (concat
        (actor-descriptors (graph-actors topology))
        (route-descriptors (graph-routes topology)))
      (concat
        (message-descriptors (graph-messages topology))
        (rule-descriptors rules)))
    [(get (get (first (outputs topology)) "output") "type")])))
(let delta-descriptors (fn [[value Delta]] -> (List TypeDescriptor)
  (concat
    (concat
      (actor-descriptors (get value "actors"))
      (route-descriptors (get value "routes")))
    (message-descriptors (get value "messages")))))
(let lower-program (fn [[value Program]] -> Modification
  (let topology (get value "graph"))
  (let actors (graph-actors topology))
  (let routes (assigned-routes (graph-routes topology)))
  (as Modification
      {:actors (map (fn [[candidate Actor]] -> LowerActor
                      (lower-actor-with-routes routes candidate))
                    actors)
       :messages (map lower-message (graph-messages topology))
       :kills (as (List String) [])
       :rules (map lower-rule (get value "rules"))
       :types (descriptor-table (program-descriptors topology (get value "rules")))
       :result (result-boundary topology)})))
(let lower (fn [[value Graph]] -> Modification
  (lower-program (program value (as (List Rule) [])))))

;; Resident rule deltas are operational artifacts, not graph values.
(let delta (fn [[actors (List Actor)] [routes (List StoredRoute)]
                [messages (List Message)] [kills (List String)]] -> Delta
  (as Delta {:actors actors :routes routes :messages messages :kills kills})))
(let node-delta (fn [I O] [[value (Node I O)]] -> Delta
  (as Delta {:actors (get value "actors") :routes (get value "routes")
             :messages (get value "messages") :kills []})))
(let merge-delta (fn [[left Delta] [right Delta]] -> Delta
  (as Delta {:actors (concat (get left "actors") (get right "actors"))
             :routes (concat (get left "routes") (get right "routes"))
             :messages (concat (get left "messages") (get right "messages"))
             :kills (concat (get left "kills") (get right "kills"))})))
(let delta-edge (fn [I T O] [[change Delta] [from (Node I T)] [to (Node T O)]] -> Delta
  (as Delta {:actors (get change "actors")
             :routes (concat (get change "routes")
                             [(stored-route (get from "output") (get to "input"))])
             :messages (get change "messages") :kills (get change "kills")})))
(let delta-route (fn [A B] [[change Delta] [from (Port A)] [to (Port B)]] -> Delta
  (as Delta {:actors (get change "actors")
             :routes (concat (get change "routes") [(stored-route from to)])
             :messages (get change "messages") :kills (get change "kills")})))
(let delta-message (fn [T] [[change Delta] [to (Port T)] [value T]] -> Delta
  (as Delta {:actors (get change "actors") :routes (get change "routes")
             :messages (concat (get change "messages") [(typed-message to value)])
             :kills (get change "kills")})))
(let delta-message-front (fn [T] [[change Delta] [to (Port T)] [value T]] -> Delta
  (as Delta {:actors (get change "actors") :routes (get change "routes")
             :messages (concat [(typed-message to value)] (get change "messages"))
             :kills (get change "kills")})))
(let lower-delta (fn [[value Delta]] -> LowerDelta
  (let actors (get value "actors"))
  (let routes (assigned-routes (get value "routes")))
  (as LowerDelta
    {:actors (map (fn [[candidate Actor]] -> LowerActor
                    (lower-actor-with-routes routes candidate))
                  actors)
     :messages (map lower-message (get value "messages"))
     :kills (get value "kills")
     :rules (as (List LowerRule) [])
     :types (descriptor-table (delta-descriptors value))})))

;; A resident program may begin with rule-observed exits that only become
;; connected after a rule returns its operational delta. Its explicit boundary
;; remains outside Graph validation for that reason.
(let lower-resident (fn [T] [[change Delta] [rules (List Rule)] [result (Port T)]] -> Modification
  (let lowered (lower-delta change))
  (as Modification {:actors (get lowered "actors")
                      :messages (get lowered "messages")
                      :kills (get lowered "kills")
                      :rules (map lower-rule rules)
                      :types (descriptor-table
                               (concat (delta-descriptors change)
                                       [(get (store-port result) "type")]))
                      :result (as ResultBoundary {:from (store-port result)})})))
