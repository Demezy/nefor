(require "core.types")
(require "nefor.graph")
(require "nefor.mag")

;; Public, node-oriented composition. These functions construct larger Node
;; values from smaller ones; ports and routes remain representation details.

(let sequence-empty-factory "nefor.factory.sequence-empty")
(let collector-factory "nefor.factory.collector")
(let product-split-factory "nefor.factory.product-split")
(let product-join-factory "nefor.factory.product-join")
(let discard-factory "nefor.factory.discard")

(type SequenceEmptyParams {})
(type CollectorParams {:expected_senders (List String)})
(type ProductSplitParams {})
(type ProductJoinParams {:expected_senders (List String)})
(type DiscardParams {})

(let composite-id
  (fn [[left String] [operator String] [right String]] -> String
    (str left (str operator right))))

(let compound-nodes
  (fn [[name String] [owned (List nefor.graph.Actor)]
       [children (List nefor.graph.LogicalNode)]]
    -> (List nefor.graph.LogicalNode)
    (concat
      [(nefor.graph.logical-node [name] (nefor.graph.actor-ids owned))]
      (nefor.graph.prefix-logical-nodes name children))))

;; Establish one visible abstraction boundary around an existing node. Ordinary
;; composition stays transparent; named functions use this when their returned
;; subgraph should appear as one expandable node. The executable node identity
;; stays unchanged; `name` is only the new logical path segment.
(let named
  (fn [I O] [[name String] [value (nefor.graph.Node I O)]]
    -> (nefor.graph.Node I O)
    (nefor.graph.node-with-operations-and-nodes (get value "id") (get value "role")
      (get value "actors") (get value "routes") (get value "messages")
      (get value "operations")
      (compound-nodes name [] (get value "nodes"))
      (get value "input") (get value "output"))))

(let rename-path-root
  (fn [[name String] [value nefor.graph.LogicalNode]] -> nefor.graph.LogicalNode
    (nefor.graph.logical-node
      (concat [name] (remove-at (get value "path") 0))
      (get value "members"))))

;; Runtime actor ids and logical names are different identities. Constructors
;; default the logical root to their actor id; `rename` gives a placed node a
;; concise local name without rewriting any executable actor reference.
(let rename
  (fn [I O] [[name String] [value (nefor.graph.Node I O)]]
    -> (nefor.graph.Node I O)
    (nefor.graph.node-with-operations-and-nodes (get value "id") (get value "role")
      (get value "actors") (get value "routes") (get value "messages")
      (get value "operations")
      (map (fn [[candidate nefor.graph.LogicalNode]] -> nefor.graph.LogicalNode
             (rename-path-root name candidate))
           (get value "nodes"))
      (get value "input") (get value "output"))))

;; Sequential composition preserves a source constructor boundary on the left
;; so validation can still verify its packed constant. Activation itself is
;; derived later from the completed topology: an unfed Unit input bootstraps,
;; while the same composite behind an incoming edge remains dependency-driven.
(let sequential-role
  (fn [A B C]
    [[left (nefor.graph.Node A B)] [right (nefor.graph.Node B C)]] -> String
    (if (= (get left "role") "source") "source" "ordinary")))

(let compose
  (fn [A B C]
    [[left (nefor.graph.Node A B)] [right (nefor.graph.Node B C)]]
    -> (nefor.graph.Node A C)
    (nefor.graph.node-with-operations-and-nodes
      (composite-id (get left "id") ">>>" (get right "id"))
      (sequential-role left right)
      (concat (get left "actors") (get right "actors"))
      (concat
        (concat (get left "routes") (get right "routes"))
        [(nefor.graph.stored-route
           (get left "output") (get right "input"))])
      (concat (get left "messages") (get right "messages"))
      (concat (get left "operations") (get right "operations"))
      (concat (get left "nodes") (get right "nodes"))
      (get left "input")
      (get right "output"))))

;; Established Arrow spelling for left-to-right composition. This is an alias
;; with exactly the same semantics, not a separate symbolic DSL.
(let >>>
  (fn [A B C]
    [[left (nefor.graph.Node A B)] [right (nefor.graph.Node B C)]]
    -> (nefor.graph.Node A C)
    (compose left right)))

;; Forget one node's result and retain only its successful completion. This is
;; the ordinary functional `void` operation expressed as a node.
(let discard
  (fn [T] [[id String] [type (TypeTag T)]] -> (nefor.graph.Node T Unit)
    (let input
      (nefor.graph.port id type "nefor.node.DiscardInput"))
    (let output
      (nefor.graph.port id (type-tag Unit) "mag.Unit"))
    (nefor.graph.node id "ordinary"
      [(nefor.graph.actor id discard-factory
         [(type-evidence type)] (as DiscardParams {})
         (nefor.graph.store-port input)
         [(nefor.graph.store-port output)])]
      [] [] input output)))

;; Run `right` after `left` succeeds, discarding the left result and keeping
;; the right result. `*>` is the established Applicative spelling.
(let then
  (fn [I A B]
    [[id String]
     [left (nefor.graph.Node I A)]
     [right (nefor.graph.Node Unit B)]]
    -> (nefor.graph.Node I B)
    (let bridge (discard (str id ".discard") (type-tag A)))
    (nefor.graph.node-with-operations-and-nodes id (sequential-role left bridge)
      (concat (get left "actors")
        (concat (get bridge "actors") (get right "actors")))
      (concat
        (concat (get left "routes")
          (concat (get bridge "routes") (get right "routes")))
        [(nefor.graph.stored-route (get left "output") (get bridge "input"))
         (nefor.graph.stored-route (get bridge "output") (get right "input"))])
      (concat (get left "messages")
        (concat (get bridge "messages") (get right "messages")))
      (concat (get left "operations")
        (concat (get bridge "operations") (get right "operations")))
      (compound-nodes id (get bridge "actors")
        (concat (get left "nodes") (get right "nodes")))
      (get left "input")
      (get right "output"))))
(let *>
  (fn [I A B]
    [[id String]
     [left (nefor.graph.Node I A)]
     [right (nefor.graph.Node Unit B)]]
    -> (nefor.graph.Node I B)
    (then id left right)))

;; Run two nodes from the same input. The product boundary records that both
;; results are required; its ordinary firing semantics waits for both child
;; outputs and preserves left-to-right order.
(let fanout
  (fn [I A B]
    [[id String]
     [left (nefor.graph.Node I A)]
     [right (nefor.graph.Node I B)]]
    -> (nefor.graph.Node I (+ A B))
    (let input
      (nefor.graph.identity (str id ".input") (type-tag I)))
    (let output-id (str id ".output"))
    (let output-input
      (nefor.graph.port output-id (type-tag (+ A B))
        "nefor.node.ProductInput"))
    (let output-port
      (nefor.graph.port output-id (type-tag (+ A B))
        "nefor.node.ProductOutput"))
    (let output
      (nefor.graph.actor output-id product-join-factory
        [(type-evidence (type-tag A)) (type-evidence (type-tag B))]
        (as ProductJoinParams
          {:expected_senders
            [(get (get left "output") "actor")
             (get (get right "output") "actor")]})
        (nefor.graph.store-port output-input)
        [(nefor.graph.store-port output-port)]))
    (nefor.graph.node-with-operations-and-nodes id "ordinary"
      (concat
        (get input "actors")
        (concat
          (get left "actors")
          (concat (get right "actors") [output])))
      (concat
        (concat
          (get input "routes")
          (concat
            (get left "routes")
            (get right "routes")))
        [(nefor.graph.stored-route (get input "output") (get left "input"))
         (nefor.graph.stored-route (get input "output") (get right "input"))
         (nefor.graph.stored-route (get left "output") output-input)
         (nefor.graph.stored-route (get right "output") output-input)])
      (concat
        (get input "messages")
        (concat
          (get left "messages")
          (get right "messages")))
      (concat
        (get input "operations")
        (concat (get left "operations") (get right "operations")))
      (compound-nodes id
        (concat (get input "actors") [output])
        (concat (get left "nodes") (get right "nodes")))
      (get input "input")
      output-port)))

;; Apply two nodes independently to the ordered components of a product. A
;; small runtime splitter is necessary because an edge carries the whole
;; product value; merely viewing one port under a component type would lose
;; the corresponding runtime projection.
(let parallel
  (fn [A B C D]
    [[id String]
     [left (nefor.graph.Node A B)]
     [right (nefor.graph.Node C D)]]
    -> (nefor.graph.Node (+ A C) (+ B D))
    (let splitter-id (str id ".input"))
    (let splitter-input
      (nefor.graph.port splitter-id (type-tag (+ A C))
        "nefor.node.ProductInput"))
    (let splitter-left
      (nefor.graph.port splitter-id (type-tag A)
        "nefor.node.ProductLeft"))
    (let splitter-right
      (nefor.graph.port splitter-id (type-tag C)
        "nefor.node.ProductRight"))
    (let splitter
      (nefor.graph.actor splitter-id product-split-factory
        [(type-evidence (type-tag A)) (type-evidence (type-tag C))]
        (as ProductSplitParams {})
        (nefor.graph.store-port splitter-input)
        [(nefor.graph.store-port splitter-left)
         (nefor.graph.store-port splitter-right)]))
    (let output-id (str id ".output"))
    (let output-input
      (nefor.graph.port output-id (type-tag (+ B D))
        "nefor.node.ProductInput"))
    (let output-port
      (nefor.graph.port output-id (type-tag (+ B D))
        "nefor.node.ProductOutput"))
    (let output
      (nefor.graph.actor output-id product-join-factory
        [(type-evidence (type-tag B)) (type-evidence (type-tag D))]
        (as ProductJoinParams
          {:expected_senders
            [(get (get left "output") "actor")
             (get (get right "output") "actor")]})
        (nefor.graph.store-port output-input)
        [(nefor.graph.store-port output-port)]))
    (nefor.graph.node-with-operations-and-nodes id "ordinary"
      (concat [splitter]
        (concat
          (get left "actors")
          (concat (get right "actors") [output])))
      (concat
        (concat
          (get left "routes")
          (get right "routes"))
        [(nefor.graph.stored-route splitter-left (get left "input"))
         (nefor.graph.stored-route splitter-right (get right "input"))
         (nefor.graph.stored-route (get left "output") output-input)
         (nefor.graph.stored-route (get right "output") output-input)])
      (concat
        (get left "messages")
        (get right "messages"))
      (concat (get left "operations") (get right "operations"))
      (compound-nodes id [splitter output]
        (concat (get left "nodes") (get right "nodes")))
      splitter-input
      output-port)))

;; Nominal branches are explicit runtime operations. `choose` unpacks Either,
;; runs each payload branch, and lifts each result back into the output Either.
;; No route treats an ADT constructor as a transparent structural row.
(let adt-unpack-factory "nefor.factory.adt-unpack")
(let adt-pack-factory "nefor.factory.adt-pack")
(type AdtUnpackParams {:owner TypeDescriptor
                       :left_constructor String
                       :right_constructor String})
(type AdtPackParams {:owner TypeDescriptor :constructor String})

(let pack-adt
  (fn [T O] [[id String] [input-type (TypeTag T)] [owner-type (TypeTag O)]
             [constructor String]] -> (nefor.graph.Node T O)
    (let input (nefor.graph.port id input-type "nefor.adt.Payload"))
    (let output (nefor.graph.port id owner-type "nefor.adt.Value"))
    (nefor.graph.node id "ordinary"
      [(nefor.graph.actor id adt-pack-factory
         [(type-evidence input-type) (type-evidence owner-type)]
         (as AdtPackParams
           {:owner (type-evidence owner-type) :constructor constructor})
         (nefor.graph.store-port input) [(nefor.graph.store-port output)])]
      [] [] input output)))

(let choose
  (fn [A B C D]
    [[id String]
     [left (nefor.graph.Node A C)]
     [right (nefor.graph.Node B D)]]
    -> (nefor.graph.Node (core.types.Either A B) (core.types.Either C D))
    (let split-id (str id ".split"))
    (let split-input
      (nefor.graph.port split-id (type-tag (core.types.Either A B)) "nefor.adt.Value"))
    (let split-left
      (nefor.graph.port split-id (type-tag A) "nefor.adt.First"))
    (let split-right
      (nefor.graph.port split-id (type-tag B) "nefor.adt.Second"))
    (let split
      (nefor.graph.actor split-id adt-unpack-factory
        [(type-evidence (type-tag (core.types.Either A B)))
         (type-evidence (type-tag A)) (type-evidence (type-tag B))]
        (as AdtUnpackParams
          {:owner (type-evidence (type-tag (core.types.Either A B)))
           :left_constructor "Left" :right_constructor "Right"})
        (nefor.graph.store-port split-input)
        [(nefor.graph.store-port split-left) (nefor.graph.store-port split-right)]))
    (let lift-left
      (pack-adt (str id ".left") (type-tag C)
        (type-tag (core.types.Either C D)) "Left"))
    (let lift-right
      (pack-adt (str id ".right") (type-tag D)
        (type-tag (core.types.Either C D)) "Right"))
    (let output
      (nefor.graph.identity (str id ".output")
        (type-tag (core.types.Either C D))))
    (nefor.graph.node-with-operations-and-nodes id "ordinary"
      (concat [split]
        (concat (get left "actors")
          (concat (get right "actors")
            (concat (get lift-left "actors")
              (concat (get lift-right "actors") (get output "actors"))))))
      (concat (get left "routes")
        (concat (get right "routes")
          (concat (get lift-left "routes")
            (concat (get lift-right "routes")
              (concat (get output "routes")
                [(nefor.graph.stored-route split-left (get left "input"))
                 (nefor.graph.stored-route split-right (get right "input"))
                 (nefor.graph.stored-route (get left "output") (get lift-left "input"))
                 (nefor.graph.stored-route (get right "output") (get lift-right "input"))
                 (nefor.graph.stored-route (get lift-left "output") (get output "input"))
                 (nefor.graph.stored-route (get lift-right "output") (get output "input"))])))))
      (concat (get left "messages")
        (concat (get right "messages")
          (concat (get lift-left "messages")
            (concat (get lift-right "messages") (get output "messages")))))
      (concat (get left "operations")
        (concat (get right "operations")
          (concat (get lift-left "operations")
            (concat (get lift-right "operations") (get output "operations")))))
      (compound-nodes id
        (concat [split]
          (concat (get lift-left "actors")
            (concat (get lift-right "actors") (get output "actors"))))
        (concat (get left "nodes") (get right "nodes")))
      split-input (get output "output"))))

;; Lift a successful node into Result. This explicit operation is required
;; before binding deterministic continuations with `>=>`.
(let lift-result
  (fn [I E O] [[id String] [error-type (TypeTag E)]
               [value (nefor.graph.Node I O)]]
    -> (nefor.graph.Node I (core.types.Result E O))
    (let lift
      (pack-adt (str id ".ok") (type-tag O)
        (type-tag (core.types.Result E O)) "Ok"))
    (let composed (>>> value lift))
    (nefor.graph.node-with-operations-and-nodes id (get composed "role")
      (get composed "actors") (get composed "routes") (get composed "messages")
      (get composed "operations")
      (compound-nodes id (get lift "actors") (get value "nodes"))
      (get composed "input") (get composed "output"))))

;; Kleisli composition for nominal Result. Error is repacked unchanged; only
;; Ok is unpacked into the continuation, whose Result output remains intact.
(let >=>
  (fn [I E A B]
    [[left (nefor.graph.Node I (core.types.Result E A))]
     [right (nefor.graph.Node A (core.types.Result E B))]]
    -> (nefor.graph.Node I (core.types.Result E B))
    (let id (composite-id (get left "id") ">=>" (get right "id")))
    (let split-id (str id ".split"))
    (let split-input
      (nefor.graph.port split-id (type-tag (core.types.Result E A)) "nefor.adt.Value"))
    (let failed
      (nefor.graph.port split-id (type-tag E) "nefor.adt.First"))
    (let succeeded
      (nefor.graph.port split-id (type-tag A) "nefor.adt.Second"))
    (let split
      (nefor.graph.actor split-id adt-unpack-factory
        [(type-evidence (type-tag (core.types.Result E A)))
         (type-evidence (type-tag E)) (type-evidence (type-tag A))]
        (as AdtUnpackParams
          {:owner (type-evidence (type-tag (core.types.Result E A)))
           :left_constructor "Error" :right_constructor "Ok"})
        (nefor.graph.store-port split-input)
        [(nefor.graph.store-port failed) (nefor.graph.store-port succeeded)]))
    (let preserve-error
      (pack-adt (str id ".error") (type-tag E)
        (type-tag (core.types.Result E B)) "Error"))
    (let output
      (nefor.graph.identity (str id ".output")
        (type-tag (core.types.Result E B))))
    (nefor.graph.node-with-operations-and-nodes id (get left "role")
      (concat (get left "actors")
        (concat [split]
          (concat (get right "actors")
            (concat (get preserve-error "actors") (get output "actors")))))
      (concat (get left "routes")
        (concat (get right "routes")
          (concat (get preserve-error "routes")
            (concat (get output "routes")
              [(nefor.graph.stored-route (get left "output") split-input)
               (nefor.graph.stored-route succeeded (get right "input"))
               (nefor.graph.stored-route failed (get preserve-error "input"))
               (nefor.graph.stored-route (get right "output") (get output "input"))
               (nefor.graph.stored-route (get preserve-error "output") (get output "input"))]))))
      (concat (get left "messages")
        (concat (get right "messages")
          (concat (get preserve-error "messages") (get output "messages"))))
      (concat (get left "operations")
        (concat (get right "operations")
          (concat (get preserve-error "operations") (get output "operations"))))
      (concat (get left "nodes")
        (nefor.graph.attach-logical-members (get right "nodes")
          (concat [split-id]
            (concat (nefor.graph.actor-ids (get preserve-error "actors"))
              (nefor.graph.actor-ids (get output "actors"))))))
      (get left "input") (get output "output"))))
(let sequence-empty
  (fn [I O] [[id String]] -> (nefor.graph.Node I (List O))
    (let actor-id (str id ".empty"))
    (let input
      (nefor.graph.port actor-id (type-tag I) "nefor.node.SequenceInput"))
    (let output
      (nefor.graph.port actor-id (type-tag (List O))
        "nefor.node.SequenceOutput"))
    (let actor
      (nefor.graph.actor actor-id sequence-empty-factory
        [(type-evidence (type-tag I)) (type-evidence (type-tag O))]
        (as SequenceEmptyParams {})
        (nefor.graph.store-port input)
        [(nefor.graph.store-port output)]))
    (nefor.graph.node-with-operations-and-nodes id "ordinary" [actor]
      (as (List nefor.graph.StoredRoute) [])
      (as (List nefor.graph.Message) [])
      (as (List nefor.mag.ProgramOperation) [])
      [(nefor.graph.logical-node [id] [(get actor "id")])]
      input output)))

(let sequence-nonempty
  (fn [I O] [[id String] [nodes (List (nefor.graph.Node I O))]]
    -> (nefor.graph.Node I (List O))
    (let relay
      (nefor.graph.identity (str id ".input") (type-tag I)))
    (let collector-id (str id ".collector"))
    (let collector-input
      (nefor.graph.port collector-id (type-tag O) "nefor.dynamic.Item"))
    (let collector-output
      (nefor.graph.port collector-id (type-tag (List O))
        "nefor.dynamic.Collected"))
    (let expected-senders
      (map
        (fn [[candidate (nefor.graph.Node I O)]] -> String
          (get (get candidate "output") "actor"))
        nodes))
    (let collector
      (nefor.graph.actor collector-id collector-factory
        [(type-evidence (type-tag O))]
        (as CollectorParams {:expected_senders expected-senders})
        (nefor.graph.store-port collector-input)
        [(nefor.graph.store-port collector-output)]))
    (let child-actors
      (flat-map
        (fn [[candidate (nefor.graph.Node I O)]]
          -> (List nefor.graph.Actor)
          (get candidate "actors"))
        nodes))
    (let child-routes
      (flat-map
        (fn [[candidate (nefor.graph.Node I O)]]
          -> (List nefor.graph.StoredRoute)
          (get candidate "routes"))
        nodes))
    (let child-messages
      (flat-map
        (fn [[candidate (nefor.graph.Node I O)]]
          -> (List nefor.graph.Message)
          (get candidate "messages"))
        nodes))
    (let child-operations
      (flat-map
        (fn [[candidate (nefor.graph.Node I O)]]
          -> (List nefor.mag.ProgramOperation)
          (get candidate "operations"))
        nodes))
    (let input-routes
      (map
        (fn [[candidate (nefor.graph.Node I O)]]
          -> nefor.graph.StoredRoute
          (nefor.graph.stored-route
            (get relay "output") (get candidate "input")))
        nodes))
    (let output-routes
      (map
        (fn [[candidate (nefor.graph.Node I O)]]
          -> nefor.graph.StoredRoute
          (nefor.graph.stored-route
            (get candidate "output") collector-input))
        nodes))
    (nefor.graph.node-with-operations-and-nodes id "ordinary"
      (concat (get relay "actors") (concat child-actors [collector]))
      (concat
        (get relay "routes")
        (concat child-routes (concat input-routes output-routes)))
      (concat (get relay "messages") child-messages)
      (concat (get relay "operations") child-operations)
      (compound-nodes id
        (concat (get relay "actors") [collector])
        (flat-map
          (fn [[candidate (nefor.graph.Node I O)]]
            -> (List nefor.graph.LogicalNode)
            (get candidate "nodes"))
          nodes))
      (get relay "input")
      collector-output)))

;; The supplied compile-time List fixes both producer count and result order.
;; The output is therefore an ordinary fixed List, not the DynamicList
;; producer protocol or either DynamicEach/DynamicAll consumer effect.
(let sequence
  (fn [I O] [[id String] [nodes (List (nefor.graph.Node I O))]]
    -> (nefor.graph.Node I (List O))
    (if (= (count nodes) 0)
      (sequence-empty id)
      (sequence-nonempty id nodes))))
