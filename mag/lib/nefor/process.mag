(require "nefor.graph")
(require "nefor.contracts")

;; Relative paths are resolved by the process actor against the MAG host's
;; inherited working directory. Keeping the captured base as data makes that
;; authority explicit in every process request.
(let cwd ".")
(let factory "nefor.factory.process-exec")
(type ProcessExecParams {:argv (List String)
                         :cwd String
                         :timeout nefor.contracts.Timeout})
(type ProcessExecActorParams {:argv (List String)
                              :cwd String
                              :timeout nefor.contracts.Timeout
                              :exited_type SemanticTypeId
                              :signaled_type SemanticTypeId})

(let exec (fn [[name String] [params ProcessExecParams]]
  -> (nefor.graph.Node (| Unit nefor.contracts.Text) nefor.contracts.ProcessResult)
  (let input (nefor.graph.port name
                (type-tag (| Unit nefor.contracts.Text))
                "nefor.process.Input"))
  (let output (nefor.graph.port name
                 (type-tag nefor.contracts.ProcessResult)
                 "nefor.process.Result"))
  (as (nefor.graph.Node (| Unit nefor.contracts.Text) nefor.contracts.ProcessResult)
      {:id name :role "ordinary"
       :actors [(nefor.graph.actor name factory []
                   (as ProcessExecActorParams
                     {:argv (get params "argv")
                      :cwd (get params "cwd")
                      :timeout (get params "timeout")
                      :exited_type
                        (type-id
                          (type-evidence
                            (type-tag nefor.contracts.ProcessExited)))
                      :signaled_type
                        (type-id
                          (type-evidence
                            (type-tag nefor.contracts.ProcessSignaled)))})
                   (nefor.graph.store-port input)
                   [(nefor.graph.store-port output)])]
       :routes (as (List nefor.graph.StoredRoute) [])
       :messages []
       :operations []
       :nodes [(nefor.graph.logical-node [name] [name])]
       :input input
       :output output})))
