(require "nefor.graph")
(require "nefor.contracts")

(let factory "nefor.factory.shell-script")
(type ShellScriptParams {:script String
                         :cwd String
                         :timeout nefor.contracts.Timeout})
(type ShellScriptActorParams {:script String
                              :cwd String
                              :timeout nefor.contracts.Timeout
                              :exited_type SemanticTypeId
                              :signaled_type SemanticTypeId})

(let script (fn [[name String] [params ShellScriptParams]]
  -> (nefor.graph.Node (| Unit nefor.contracts.Text) nefor.contracts.ProcessResult)
  (let input (nefor.graph.port name
                (type-tag (| Unit nefor.contracts.Text))
                "nefor.process.Input"))
  (let output (nefor.graph.port name
                 (type-tag nefor.contracts.ProcessResult)
                 "nefor.process.Result"))
  (as (nefor.graph.Node (| Unit nefor.contracts.Text) nefor.contracts.ProcessResult)
      {:id name :role "ordinary"
       :actors [(nefor.graph.actor name factory []
                   (as ShellScriptActorParams
                     {:script (get params "script")
                      :cwd (get params "cwd")
                      :timeout (get params "timeout")
                      :exited_type
                        (type-id
                          (type-evidence
                            (type-tag nefor.contracts.ProcessExited)))
                      :signaled_type
                        (type-id
                          (type-evidence
                            (type-tag nefor.contracts.ProcessSignaled)))})
                   (nefor.graph.store-port input)
                   [(nefor.graph.store-port output)])]
       :routes (as (List nefor.graph.StoredRoute) [])
       :messages []
       :rules []
       :nodes [(nefor.graph.logical-node [name] [name])]
       :input input
       :output output})))

;; The common dependency form: a Unit occurrence starts the authored script.
;; `script` keeps the wider Unit | Text boundary for callers that deliberately
;; pass textual stdin; `run` makes deterministic sequencing read directly.
(let run (fn [[name String] [params ShellScriptParams]]
  -> (nefor.graph.Node Unit nefor.contracts.ProcessResult)
  (let value (script name params))
  (let input
    (nefor.graph.port name (type-tag Unit) "nefor.process.Input"))
  (nefor.graph.node-with-rules-and-nodes name "ordinary"
    (get value "actors") (get value "routes") (get value "messages")
    (get value "rules") (get value "nodes") input (get value "output"))))
