import nefor.graph.{}

type CreateSpec {repository: String, path: String, branch: String, base: String}

type OpenSpec {repository: String, path: String, branch: String}

type Worktree {repository: String, path: String, branch: String, head: String}

type WorktreeError {operation: String, kind: String, message: String}

let create_factory = "nefor.factory.worktree-create"

let open_factory = "nefor.factory.worktree-open"

let create: fn(String, CreateSpec) -> nefor.graph.Node<Unit, Worktree> = |id, spec| => {
  let input = nefor.graph.port(id, type_tag<Unit>(), "mag.Unit")
  let output = nefor.graph.port(id, type_tag<Worktree>(), "nefor.worktree.Ready")
  nefor.graph.node_with_operations_and_nodes(id, "ordinary", [nefor.graph.closed_actor(id, create_factory, [], spec, nefor.graph.store_port(input), [nefor.graph.store_port(output)], [])], ([]: List<nefor.graph.StoredRoute>), [], [], [nefor.graph.logical_node([id], [id])], input, output)
}

let open: fn(String, OpenSpec) -> nefor.graph.Node<Unit, Worktree> = |id, spec| => {
  let input = nefor.graph.port(id, type_tag<Unit>(), "mag.Unit")
  let output = nefor.graph.port(id, type_tag<Worktree>(), "nefor.worktree.Ready")
  nefor.graph.node_with_operations_and_nodes(id, "ordinary", [nefor.graph.closed_actor(id, open_factory, [], spec, nefor.graph.store_port(input), [nefor.graph.store_port(output)], [])], ([]: List<nefor.graph.StoredRoute>), [], [], [nefor.graph.logical_node([id], [id])], input, output)
}
